# @module[/Std/Unit/Cmp%]
#  The @l{Cmp@} instance for @l{Unit@}.
#
#  All @l{Unit@} values are equal, so this isn't a very interesting
#  implementation. Provided for sake of completeness.
#
#  See @l{/Std/Cmp%.Cmp@} for more about the @l{Cmp@} interface and how to use
#  it.

Unit@ .= /Std/Unit%;
Cmp@, Equal .= /Std/Cmp%;

# @func[Cmp] The unit comparison operation.
#  @arg[Unit@][a] The first operand.
#  @arg[Unit@][b] The second operand.
#  @returns[Compared@] Equal.
Cmp@<Unit@>
Cmp = (Unit@ _a, Unit@ _b) {
  Equal;
};

@(Cmp);
