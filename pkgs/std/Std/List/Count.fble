# @module[/Std/List/Count%]
#  Utility for counting elements of a list that satisfy a given condition.
#
#  This is kept separate from @l{/Std/List/Search%} because it has an extra
#  dependency on @l{Int@}.

Bool@ .= /Std/Bool%;
Int@, 0, Incr .= /Std/Int%;
List@ .= /Std/List%;

# @func[Count] Counts elements on the list that satisfy a condition.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The list to check.
#  @arg[(T@) { Bool@; }][p] The condition to check for.
#  @returns[Int@] The number of elements on the list satisfying the condition.
#
#  For example, to count the number of odd integers on a list of integers:
#
#  @code[fble] @
#   List@<Int@> list = ...;
#   Int@ num_odd = Count(list, IsOdd);
#
#  Sometimes it is convenient to use function bind syntax to pass the
#  predicate. The example above could be written using function bind syntax as
#  follows:
#
#  @code[fble] @
#   List@<Int@> list = ...;
#   Int@ num_odd = {
#     Int@ x := Count(list);
#     Eq(0, Mod(x, 2));
#   };
#
#  If you are only interested in the length of the list, use the
#  @l{/Std/List/Index%.Length} function.
<@ T@>(List@<T@>, (T@) { Bool@; }) { Int@; }
Count = <@ T@>(List@<T@> list, (T@) { Bool@; } p) {
  list.?(empty: 0);
  Int@ tail = Count(list.items.tail, p);
  p(list.items.head).?(false: tail);
  Incr(tail);
};

@(Count);
