
Bool@, True, False .= /Std/Bool%;
Break, Continue .= /Std/For%;
List@ .= /Std/List%;
Maybe@ .= /Std/Maybe%;

Addr@ .= /Hwdg/Addr%;
Data@ .= /Hwdg/Data%;

Map@, Entry@, For, ForEach, Put, Get,
Empty .= /Std/Map%.Of(/Hwdg/Addr%.Data)<Data@>;

Memory@ = Map@;

# Insert all values from 'v' into 'm'.
(Memory@, Memory@) { Memory@; }
Override = (Memory@ m, Memory@ v) {
  Memory@ s, Entry@ e := ForEach(v, m);
  Put(s, e.key, e.value);
};

# Return true if the two memories have no addresses in common.
(Memory@, Memory@) { Bool@; }
Disjoint = (Memory@ a, Memory@ b) {
  Bool@ _, Entry@ e := For(a, True);
  Get(b, e.key).?(just: Break(False));
  Continue(True);
};

# Return true if the first memory contains the second.
(Memory@, Memory@) { Bool@; }
Contains = (Memory@ a, Memory@ b) {
  Bool@ _, Entry@ e := For(b, True);
  Maybe@<Data@> mva = Get(a, e.key);
  mva.?(nothing: Break(False));
  /Hwdg/Data/Eq%.Eq(e.value, mva.just).?(false: Break(False));
  Continue(True);
};

# Memory literal. For example:
#    Memory[a, b, c]|'001';
# The number of addresses must match the number of data.
(List@<Addr@>, List@<Data@>) { Memory@; }
Memory = (List@<Addr@> addrs, List@<Data@> data) {
    addrs.?(empty: Empty);
    Memory@ tail = Memory(addrs.items.tail, data.items.tail);
    Put(tail, addrs.items.head, data.items.head);
};

@(Memory@, Entry@, Empty, Memory, Override, Disjoint, Contains, ForEach);
