
Char@ .= /Std/Char%;
OnAscii, Char, Str .= /Std/Char/Ascii%;
String .= /Std/Char/Ascii/Stream%;
AssertEquals .= /Std/Eq/Assert%;
Lazy .= /Std/Lazy%;
List@, Items, Empty .= /Std/List%;
Stream@, ForEach .= /Std/Stream%;
ToStream .= /Std/Stream/List%;
String@ .= /Std/String%;
Test@ .= /Std/Test%;
TestSuite = OnAscii(/Std/Test%.TestSuite);
Test = OnAscii(/Std/Test%.Test);
Unit@, Unit .= /Std/Unit%;

Test@ Tests = TestSuite|Stream[
  Test|ForEach({
    Unit@ _ := Lazy;
    Stream@<Char@> stream = String|hello;

    # If we iterate in order, it should have the effect of reversing the
    # string, because earlier items in the input string are closer to the end
    # of the output string.
    String@ got = ForEach(stream, Empty<Char@>, Items<Char@>);
    String@ wnt = Str|olleh;
    AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show, wnt, got);
  }),

  Test|For({
    Unit@ _ := Lazy;

    For@ = <@ A@> { +(A@ continue, A@ break); };
    Continue = <@ A@>(A@ x) { For@(continue: x); };
    Break = <@ A@>(A@ x) { For@(break: x); };

    <@ A@>(Stream@<A@>)<@ B@>(B@, (A@, B@) { For@<B@>; }) { B@; }
    For = <@ A@>(Stream@<A@> stream)<@ B@>(B@ base, (A@, B@) { For@<B@>; } body) {
      stream.?(empty: base);
      For@<B@> fb = body(stream.items.head, base);
      fb.?(break: fb.break);
      For(stream.items.tail(Unit), fb.continue, body);
    };

    List@<Char@> list = Items(Char|a, Items(Char|b, Items(Char|c, list)));
    Stream@<Char@> stream = ToStream(list);

    String@ got = {
      Char@ c, String@ s := For(stream, Str|'');
      String@ ns = Items(c, s);
      /Std/Char/Eq%.Eq(c, Char|b).?(true: Break(ns));
      Continue(ns);
    };
    String@ wnt = Str|ba;
    AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show, wnt, got);
  }),

  /Std/Stream/Debug/Tests%.Tests,
  /Std/Stream/Null/Tests%.Tests,
  /Std/Stream/String/Tests%.Tests
];

@(Tests);
