
Char@ .= /Std/Char%;
Format, FormatE, String .= /Std/Char/Ascii/Stream%;
Concat .= /Std/Stream/List%;
Stream@, End .= /Std/Stream%;

Car@, Cars@ .= /Computrainer/Car%;
Dir@ .= /Computrainer/Dir%;
Coord@, Grid@, Grid .= /Computrainer/Grid%;
Gate@ .= /Computrainer/Gate%;
Gates@, Model@ .= /Computrainer/Model%;
Phase@ .= /Computrainer/State%;


(Car@) { Stream@<Char@>; }
Car = (Car@ c) {
    c.?(C: String|C, 0: String|0, 1: String|1);
};

(Dir@) { Stream@<Char@>; }
Dir = (Dir@ d) {
    d.?(up: String|up, down: String|down, left: String|left, right: String|right);
};

(Gates@) { Stream@<Char@>; }
Gates = (Gates@ gates) {
  Stream@<Char@> out, Grid<Gate@>.Entry@ e := Grid<Gate@>.ForEach(gates, End<Char@>);
  Coord@ c = e.key;
  Gate@ g = e.value;
  Stream@<Char@> head = Format|'gate %s %s '[
      /Std/Int/Show%.Show(c.x),
      /Std/Int/Show%.Show(c.y)
  ];
  Stream@<Char@> body = g.?(
      stop: String|'stop',
      move: Format|'move %s'[Dir(g.move)],
      source: Format|'source %s %s'[Car(g.source.car), Dir(g.source.dir)],
      sink: String|'sink',
      dup: Format|'dup %s %s'[Dir(g.dup.a), Dir(g.dup.b)],
      wait: Format|'wait %s'[Dir(g.wait)],
      split: Format|'split %s %s'[Dir(g.split.head), Dir(g.split.tail)],
      filter: Format|'filter %s %s %s'[Car(g.filter.car), Dir(g.filter.match), Dir(g.filter.default)]
  );
  FormatE|'%s%s%s\n'[out, head, body];
};

(Cars@) { Stream@<Char@>; }
Cars = (Cars@ cars) {
  Stream@<Char@> out, Grid<Car@>.Entry@ e := Grid<Car@>.ForEach(cars, End<Char@>);
  Coord@ c = e.key;
  Car@ car = e.value;
  FormatE|'%scar %s %s %s\n'[
      out,
      /Std/Int/Show%.Show(c.x),
      /Std/Int/Show%.Show(c.y),
      Car(car)];
};

(Grid@<Dir@>) { Stream@<Char@>; }
Routing = (Grid@<Dir@> routing) {
  Stream@<Char@> out, Grid<Dir@>.Entry@ e := Grid<Dir@>.ForEach(routing, End<Char@>);
  Coord@ c = e.key;
  Dir@ dir = e.value;
  FormatE|'%srouting %s %s %s\n'[
      out,
      /Std/Int/Show%.Show(c.x),
      /Std/Int/Show%.Show(c.y),
      Dir(dir)];
};

(Phase@) { Stream@<Char@>; }
Phase = (Phase@ phase) {
    FormatE|'phase %s\n'[phase.?(
        engines: String|engines,
        gates: String|gates)];
};

(Model@) { Stream@<Char@>; }
Model = (Model@ model) {
    Concat[
        Gates(model.gates),
        Cars(model.s.cars),
        Routing(model.s.routing),
        Phase(model.s.phase)];
};

@(Model);
