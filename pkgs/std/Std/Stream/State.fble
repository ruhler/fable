# @module[/Std/Stream/State%]
#  Provides instances of In@ and Out@ interfaces for streaming elements into
#  and out of a state monad.

List@ .= /Std/List%;
Just, Nothing .= /Std/Maybe%;
Monad@ .= /Std/Monad%;
State@ .= /Std/State%;
Stream@, Puts .= /Std/Stream%;
In@ .= /Std/Stream/In%;
Out@ .= /Std/Stream/Out%;
Unit@ .= /Std/Unit%;

# @func[In] An input stream that consumes from a list.
#  @arg[<@>@][M@] The state monad type.
#  @arg[Monad@<M@>][m] The state monad instance.
#  @arg[@][A@] The type of value to input.
#  @arg[State@<List@<A@>, M@>][s]
#   Interface for accessing the list of elements to consume from the state.
#  @returns[In@<A@, M@>] An input stream that gets elements from the state.
#
#  For example, the following is part of a pure test for the @l{GetLine}
#  function using a pure state monad to provide the input stream of
#  characters:
#
#  @code[fble] @
#   M@, m(.Monad), s(.State), Eval .= /Std/State/Pure%.Pure<String@>;
#   In@<Char@, M@> in = /Std/Stream/State%.In(m, s);
#   String@ got = Eval(GetLine(m, in), StrE|'hello\nthere\nnow');
#   String@ wnt = StrE|'hello\n';
#   AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show, wnt, got);
<<@>@ M@>(Monad@<M@>)<@ A@>(State@<List@<A@>, M@>) { In@<A@, M@>; }
In = <<@>@ M@>(Monad@<M@> m)<@ A@>(State@<List@<A@>, M@> s) {
  List@<A@> xs := m.do(s.get);
  xs.?(empty: m.return(Nothing<A@>));
  Unit@ _ := m.do(s.put(xs.items.tail));
  m.return(Just(xs.items.head));
};

# @func[Out] An output port that puts to a stream.
#  @arg[<@>@][M@] The state monad type.
#  @arg[Monad@<M@>][m] The state monad instance.
#  @arg[@][A@] The type of value to output.
#  @arg[State@<Stream@<A@>, M@>][s]
#   Interface for accessing the output stream to write to.
#  @returns[Out@<A@, M@>] An output port that streams outputs to the state.
#
#  For example, here's how you could test a hello world program, capturing the
#  output in a list:
#
#  @code[fble] @
#   M@, m(.Monad), s(.State), Exec .= /Std/State/Pure%.Pure<String@>;
#   Out@<Char@, M@> out = /Std/Stream/State%.Out(m, s);
#   String@ got = Exec(HelloWorld(m, out), Empty<String@>);
#   String@ wnt = StrE|'hello, world\n';
#   AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show, wnt, got);
<<@>@ M@>(Monad@<M@>)<@ A@>(State@<Stream@<A@>, M@>) { Out@<A@, M@>; }
Out = <<@>@ M@>(Monad@<M@> m)<@ A@>(State@<Stream@<A@>, M@> s) {
  (Stream@<A@> stream) {
    Stream@<A@> prev := m.do(s.get);
    s.put(Puts(prev, (Unit@ _) { stream; }));
  };
};

@(In, Out);
