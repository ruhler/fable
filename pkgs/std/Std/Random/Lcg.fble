# @module[/Std/Random/Lcg%]
#  Implementation of the Rand48 linear congruential pseudo random number
#  generator, which generates the same sequence of random numbers as Java's
#  java.util.Random and POSIX [ln]rand48.
#
#  This psuedo random number generator is not suitable for cryptographic use
#  cases.

Int@, Add, Shl, Shr, Mul .= /Std/Int%;
Mod .= /Std/Int/Div%;
Int, Hex .= /Std/Int/Lit%;

Prng@ .= /Std/Random/Prng%;

# @value[Rand48] Implementation of the Rand48 psuedo random number generator.
#  @type[Prng@<Int@>]
#
#  This generates a sequence of random numbers using the same 48 bit linear
#  congruential generator as Java java.util.Random and POSIX [ln]rand48.
#
#  Not suitable for cryptographic use cases.
#
#  For example:
#
#  @code[fble] @
#   Prng(.Rand48) .= /Std/Random/Lcg%;
#   Eval .= /Std/State/Pure%;
#   M@, M(.Monad), Rng .= /Std/Random/Prng/Pure%.Pure(Prng);
#
#  See @l{/Std/Random/Prng%} for a more extensive example.
Prng@<Int@> Rand48 = {
  S@ = Int@;

  Int@ m = Shl(Int|1, Int|48);
  Int@ a = Hex|5DEECE66D;
  Int@ c = Hex|B;
  (Int@) { Int@; } next = (Int@ x) { Mod(Add(Mul(a, x), c), m); };

  Int@ n = Int|32;
  (S@) { Int@; } bits = (S@ s) {
      Shr(s, Int|16);
  };

  (Int@) { S@; } seed = (Int@ s) { s; };
  (Int@, Int@, S@) { S@; } feed = (Int@ _, Int@ x, S@ s) {
      Add(x, s);
  };

  @(S@, next, n, bits, seed, feed);
};

@(Rand48);
