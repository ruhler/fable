
Char@ .= /Std/Char%;
OnAscii, Char, Str .= /Std/Char/Ascii%;
String .= /Std/Char/Ascii/Stream%;
AssertEquals .= /Std/Eq/Assert%;
Break, Continue .= /Std/For%;
Lazy .= /Std/Lazy%;
List@, Items, Empty .= /Std/List%;
Stream@ .= /Std/Stream%;
For, ForEach .= /Std/Stream/For%;
ToStream .= /Std/Stream/List%;
String@ .= /Std/String%;
Test@ .= /Std/Test%;
TestSuite = OnAscii(/Std/Test%.TestSuite);
Test = OnAscii(/Std/Test%.Test);
Unit@ .= /Std/Unit%;

Test@ Tests = TestSuite|For[
  Test|For({
    Unit@ _ := Lazy;

    # Verify we can construct and partially iterate over elements of an
    # infinite stream.
    List@<Char@> list = Items(Char|a, Items(Char|b, Items(Char|c, list)));
    Stream@<Char@> stream = ToStream(list);

    String@ got = {
      String@ s, Char@ c := For(stream, Str|'');
      String@ ns = Items(c, s);
      /Std/Char/Eq%.Eq(c, Char|b).?(true: Break(ns));
      Continue(ns);
    };
    String@ wnt = Str|ba;
    AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show, wnt, got);
  }),

  Test|ForEach({
    Unit@ _ := Lazy;
    Stream@<Char@> stream = String|hello;

    # If we iterate in order, it should have the effect of reversing the
    # string, because earlier items in the input string are closer to the end
    # of the output string.
    String@ got = {
      String@ s, Char@ c := ForEach(stream, Empty<Char@>);
      Items(c, s);
    };
    String@ wnt = Str|olleh;
    AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show, wnt, got);
  })
];

@(Tests);
