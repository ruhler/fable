# @module[/Std/Map/List%}
#  Utility for constructing maps from lists of entries.

Data@ .= /Std/Data%;
List@ .= /Std/List%;
Map@, Entry@, Put, Empty .= /Std/Map%;

# @func[Entries] Construct a map from a list of entries.
#  @arg[@][K@] The type of key.
#  @arg[Data@<K@>][data] The Data@ instance for the key type.
#  @arg[@][V@] The type of value.
#  @arg[List@<Entry@<K@, V@>>][entries]
#   List of entries to populate the map with.
#  @returns[Map@<K@, V@>]
#   A map with the given entries. Earlier entries in the entries list are used
#   in case of duplicate keys in the entries list.
#
#  This provides a convenient way to construct maps with known values. For
#  example, to map from character to drawing for rendering digits on screen:
#
#  @code[fble] @
#   Map@, Value@, Key, Get .= /Std/Map%.Of(/Std/Char/Data%.Data)<Drawing@>;
#   Entries .= /Std/Map/List%.Of(Key)<Value@>;
#   Map@ digits = Entries[
#     @(key: Char|0, value: Digit0),
#     @(key: Char|1, value: Digit1),
#     @(key: Char|2, value: Digit2),
#     @(key: Char|3, value: Digit3),
#     @(key: Char|4, value: Digit4),
#     @(key: Char|5, value: Digit5),
#     @(key: Char|6, value: Digit6),
#     @(key: Char|7, value: Digit7),
#     @(key: Char|8, value: Digit8),
#     @(key: Char|9, value: Digit9)
#   ];
<@ K@>(Data@<K@>)<@ V@>(List@<Entry@<K@, V@>>) { Map@<K@, V@>; }
Entries = <@ K@>(Data@<K@> data)<@ V@>(List@<Entry@<K@, V@>> entries) {
  entries.?(empty: Empty<K@, V@>);
  K@ key, V@ value .= entries.items.head;
  Put(data, Entries(data, entries.items.tail), key, value);
};

# @func[Of] Functions specialized for the given key and value types.
#  @arg[@][K@] The key type.
#  @arg[Data@<K@>][data] The Data@ instance to use with the map.
#  @arg[@][V@] The value type.
#  @returns[...] The methods specialized for the given key and value.
#
#  This is used to import the @l{Entries} function for specific key and value
#  types. For example:
#
#  @code[fble] @
#   Map@, Value@, Key, Get .= /Std/Map%.Of(/Std/Char/Data%.Data)<Drawing@>;
#   Entries .= /Std/Map/List%.Of(Key)<Value@>;
#   Map@ digits = Entries[...];
Of = <@ K@>(Data@<K@> data)<@ V@> {
  @(
    Entries: Entries(data)<V@>
  );
};

@(Entries, Of);
