# @module[/Std/Io/File/Utf8%]
#  Reading and writing UTF-8 encoded text files and streams.
#
#  The module provides a @l{Utf8} @l{Encoding@} that can be used with
#  @l{/Std/Io/File/Char%} for reading and writing UTF-8 encoded characters to
#  and from files and streams. It provides access to standard input and output
#  and streams for text mode. See @l{/Std/Io/File/Char%} for more on how to
#  use these functions, or if you want to open things in binary mode instead
#  of text mode.

Char@, Char, Pos .= /Std/Char%;
Int@, Decr, Add, Shl, Shr .= /Std/Int%;
Int, Hex .= /Std/Int/Lit%;
Le, Lt .= /Std/Int/Cmp%;
Mod .= /Std/Int/Div%;
IsZero .= /Std/Int/Sign%;
Byte@ .= /Std/Io/File/Byte%;
Text .= /Std/Io/File/Mode%;
Encoding@ .= /Std/Io/File/Char%;
List@, List .= /Std/List%;
Get .= /Std/List/Index%;
Maybe@, Just, Nothing .= /Std/Maybe%;
Monad@ .= /Std/Monad%;
Stream@, Return .= /Std/Stream%;
In@ .= /Std/Stream/In%;
Each .= /Std/Stream/List%;

# @dev
#  @func[Encode] Encodes a character as a sequence of UTF-8 encoded bytes.
#   @arg[Char@][c] A character to encode.
#   @returns[Stream@<Byte@>] The stream of bytes encoding the given character.
(Char@) { Stream@<Byte@>; }
Encode = (Char@ c) {
  Int@ v = Pos(c);

  # 0x00000000 - 0x0000007F:
  #        0xxxxxxx
  Le(v, Hex|7F).?(true: Return(v));

  # 0x00000080 - 0x000007FF:
  #        110xxxxx 10xxxxxx
  Le(v, Hex|7FF).?(true: Each[
    Add(Hex|C0, Shr(v, Int|6)),
    Add(Hex|80, Mod(v, Hex|40))
  ]);

  # 0x00000800 - 0x0000FFFF:
  #        1110xxxx 10xxxxxx 10xxxxxx
  Le(v, Hex|FFFF).?(true: Each[
    Add(Hex|E0, Shr(v, Int|12)),
    Add(Hex|80, Mod(Shr(v, Int|6), Hex|40)),
    Add(Hex|80, Mod(v, Hex|40))
  ]);

  # 0x00010000 - 0x001FFFFF:
  #        11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
  Le(v, Hex|1FFFFF).?(true: Each[
    Add(Hex|F0, Shr(v, Int|18)),
    Add(Hex|80, Mod(Shr(v, Int|12), Hex|40)),
    Add(Hex|80, Mod(Shr(v, Int|6), Hex|40)),
    Add(Hex|80, Mod(v, Hex|40))
  ]);

  # 0x00200000 - 0x03FFFFFF:
  #        111110xx 10xxxxxx 10xxxxxx 10xxxxxx 10xxxxxx
  Le(v, Hex|3FFFFFF).?(true: Each[
    Add(Hex|F8, Shr(v, Int|24)),
    Add(Hex|80, Mod(Shr(v, Int|18), Hex|40)),
    Add(Hex|80, Mod(Shr(v, Int|12), Hex|40)),
    Add(Hex|80, Mod(Shr(v, Int|6), Hex|40)),
    Add(Hex|80, Mod(v, Hex|40))
  ]);

  # 0x04000000 - 0x7FFFFFFF:
  #        1111110x 10xxxxxx 10xxxxxx 10xxxxxx 10xxxxxx 10xxxxxx
  Le(v, Hex|7FFFFFFF).?(true: Each[
    Add(Hex|FC, Shr(v, Int|30)),
    Add(Hex|80, Mod(Shr(v, Int|24), Hex|40)),
    Add(Hex|80, Mod(Shr(v, Int|18), Hex|40)),
    Add(Hex|80, Mod(Shr(v, Int|12), Hex|40)),
    Add(Hex|80, Mod(Shr(v, Int|6), Hex|40)),
    Add(Hex|80, Mod(v, Hex|40))
  ]);

  # Character is not a valid unicode character.
  /Std/Undef%.Undef.undef<Stream@<Byte@>>;
};

# @dev
#  @value[Utf8Limits] The shortest number of bytes needed for a character
#   @type[List@<Int@>]
#
#   The i'th entry on the list returns one more than the largest unicode code
#   point that can be encoded in i bytes.
List@<Int@> Utf8Limits = List[
  Hex|0, Hex|80, Hex|800, Hex|10000, Hex|200000, Hex|4000000, Hex|80000000
];

# @dev
#  @func[Decode] Decodes a character from a sequence of UTF-8 bytes.
#   @arg[<@>@][M@] The monadic context type.
#   @arg[Monad@<M@>][m] The monadic context.
#   @arg[In@<Byte@, M@>][in] The byte input stream.
#   @returns[In@<Char@, m@>]
#    An input stream that reads characters from the given byte stream.
#
#   Crashes if the bytes don't form a legal UTF-8 sequence of bytes.
#   TODO: Provide some way for apps to catch and handle invalid encodings.
<<@>@ M@>(Monad@<M@>, In@<Byte@, M@>) { In@<Char@, M@>; }
Decode = <<@>@ M@>(Monad@<M@> m, In@<Byte@, M@> in) {
  Maybe@<Byte@> mh := m.do(in);
  mh.?(nothing: m.return(Nothing<Char@>));
  Byte@ h = mh.just;

  # Get the content bits from the header byte along with the number of
  # expected subsequent bytes.
  Int@ v, Int@ tn .= {
    # 0xxxxxxx
    /Std/Int/Eq%.Eq(Hex|0, Shr(h, Int|7)).?(true: {
      @(v: h, tn: Int|0);
    });

    # 110xxxxx 10xxxxxx
    /Std/Int/Eq%.Eq(Hex|6, Shr(h, Int|5)).?(true: {
      @(v: Mod(h, Hex|20), tn: Int|1);
    });

    # 1110xxxx 10xxxxxx 10xxxxxx
    /Std/Int/Eq%.Eq(Hex|E, Shr(h, Int|4)).?(true: {
      @(v: Mod(h, Hex|10), tn: Int|2);
    });

    # 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
    /Std/Int/Eq%.Eq(Hex|1E, Shr(h, Int|3)).?(true: {
      @(v: Mod(h, Hex|08), tn: Int|3);
    });

    # 111110xx 10xxxxxx 10xxxxxx 10xxxxxx 10xxxxxx
    /Std/Int/Eq%.Eq(Hex|3E, Shr(h, Int|2)).?(true: {
      @(v: Mod(h, Hex|04), tn: Int|4);
    });

    # 1111110x 10xxxxxx 10xxxxxx 10xxxxxx 10xxxxxx 10xxxxxx
    /Std/Int/Eq%.Eq(Hex|7E, Shr(h, Int|1)).?(true: {
      @(v: Mod(h, Hex|02), tn: Int|5);
    });

    /Std/Undef%.Undef.undef<*(Int@ v, Int@ tn)>;
  };

  # Get the contents from the next t bytes.
  (Int@, Int@) { M@<Int@>; } Next = (Int@ v, Int@ n) {
    IsZero(n).?(true: m.return(v));
    Maybe@<Byte@> mt := m.do(in);
    mt.?(nothing: /Std/Undef%.Undef.undef<M@<Int@>>);
    Byte@ t = mt.just;
    /Std/Int/Eq%.Eq(Hex|2, Shr(t, Int|6)).?(false: {
      /Std/Undef%.Undef.undef<M@<Int@>>;
    });
    Next(Add(Shl(v, Int|6), Mod(t, Hex|40)), Decr(n));
  };

  Int@ v := m.do(Next(v, tn));

  # Make sure the shortest encoding was used.
  Lt(v, Get(Utf8Limits, tn)).?(true: {
    /Std/Undef%.Undef.undef<M@<Maybe@<Char@>>>;
  });

  m.return(Just(Char(v)));
};

# @value[Utf8] Utf8 encoder.
#  @type[Encoding@]
#
#  For example, to work with input and output streams and files using UTF-8
#  characters in binary mode:
#
#  @code[fble] @
#   Stdin, Stdout, Stderr, Read, Write, Append .= /Std/Io/File/Char%.Of(Utf8, Binary);
Encoding@ Utf8 = Encoding@(Encode, Decode);

# @values[Stdin, Stdout, Stderr, Read, Write, Append]
#  Standard input and output streams and file access using UTF-8 character
#  encodings and text mode line ending conversion.
#
#  See @l{/Std/Io/File/Char%} for more detailed documentation and examples of
#  how to use these functions.
Stdin, Stdout, Stderr, Read, Write, Append .= /Std/Io/File/Char%.Of(Utf8, Text);

@(Utf8, Stdin, Stdout, Stderr, Read, Write, Append);
