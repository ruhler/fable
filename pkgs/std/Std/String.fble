# @module[/Std/String%]
#  The String@ type.
#
#  A String@ is a list of Char@. The @l{/Std/String%} module defines the
#  @l{String@} type. Additional functionality for strings is provided in
#  submodules:
#
#  @def[{/Std/String/Cmp%}] String comparision
#  @def[{/Std/String/Data%}] Support for strings as keys in maps
#  @def[{/Std/String/Eq%}]
#   Utilities for working with string equality and substrings.
#  @def[{/Std/String/Escape%}] Standard escape sequences for strings
#  @def[{/Std/String/Lines%}] Handline of lines in strings
#  @def[{/Std/String/Show%}] Showing strings in human readable form
#
#  See also @l{/Std/Char/Ascii%}, which defines @l{Str} and @l{StrE} ASCII
#  string literals. For example, to construct a string:
#
#  @code[fble] @
#   String@ message = Str|'hello, world';
#
#  If you are only using the string to output characters, prefer to use
#  the @l{/Std/Stream%.Stream@<Char@>} type, which composes better with string
#  formatting utilities in @l{/Std/Stream/String%} and the @l{/Std/Show%}
#  interface.

Char@ .= /Std/Char%;
List@ .= /Std/List%;

# @type[String@] The string type.
#   A character string, represented as a list of Char@.
String@ = List@<Char@>;

@(String@);
