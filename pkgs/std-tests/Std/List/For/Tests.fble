# @module[/Std/List/For/Tests%]
#  Tests for /Std/List/For%.

OnAscii .= /Std/Char/Ascii%;
AssertEquals .= /Std/Eq/Assert%;
Lazy .= /Std/Lazy%;
List@, Items, Empty .= /Std/List%;
ForEach .= /Std/List/For%;
Test@ .= /Std/Test%;
Test = OnAscii(/Std/Test%.Test);
TestSuite = OnAscii(/Std/Test%.TestSuite);
Unit@ .= /Std/Unit%;

Elem@, Elems, Eqs, Shows .= /Std/List/Tests/Elem%;

# @value[Tests] Test suite for /Std/List/For%
#  @type[Test@]
Test@ Tests = TestSuite|For[
  Test|ForEach({
    Unit@ _ := Lazy;
    List@<Elem@> wnt = Elems|EDCBA;
    List@<Elem@> got = {
      List@<Elem@> b, Elem@ e := ForEach(Elems|ABCDE, Empty<Elem@>);
      Items(e, b);
    };
    AssertEquals(Eqs, Shows, wnt, got);
  })
];

@(Tests);
