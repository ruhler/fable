# @module[/Std/Test/Run%]
#  Test runner for unit tests.
#
#  This provides a @l{Run} function for running tests in a generic monadic
#  context. See @l{/Std/Test/Cli%.Run} for a command line interface to this
#  test runner.

Bool@, True, False, And .= /Std/Bool%;
Char@ .= /Std/Char%;
Str .= /Std/Char/Ascii%;
FormatE, StringE .= /Std/Char/Ascii/Stream%;
Concat, ForEach .= /Std/List%;
Monad@ .= /Std/Monad%;
Stream@ .= /Std/Stream%;
Out@ .= /Std/Stream/Out%;
String .= /Std/Stream/String%;
String@ .= /Std/String%;
Test@, TestResult@ .= /Std/Test%;
Unit@, Unit .= /Std/Unit%;

# @func[Run] Runs a test or test suite.
#  @arg[<@>@][M@] Monadic type to run the tests under.
#  @arg[Monad@<M@>][m] Monad implementation.
#  @arg[Out@<Char@, M@>][out] Stream to output progress information to.
#  @arg[String@][prefix] Prefix to use for reported test names.
#  @arg[Test@][test] The test or test suite to run.
#  @returns[M@<Bool@>] True if all tests pass, false otherwise.
#
#  Most users will prefer @l{/Std/Test/Cli%.Run}, which provides a command
#  line interface main program wrapper around this function.
#
#  For example:
#
#  @code[fble] @
#   Run(m, out, Str|'config_a', /Std/Bool/Tests%.Tests);
#
#  Which would output to the given @l{out} stream something like:
#
#  @code[txt] @
#   @[config_a.Std.Bool.True]: @PASS
#   @[config_a.Std.Bool.False]: @PASS
#   @[config_a.Std.Bool.Not.True]: @PASS
#   @[config_a.Std.Bool.Not.False]: @FAIL: Expected True, but got False
#   @[config_a.Std.Bool.Eq.FF]: @PASS
#   @[config_a.Std.Bool.Eq.FT]: @PASS
#   @[config_a.Std.Bool.Eq.TF]: @PASS
#   @[config_a.Std.Bool.Eq.TT]: @PASS
#   @[config_a.Std.Bool.Show.True]: @PASS
#   @[config_a.Std.Bool.Show.False]: @PASS
#
#  The tests are considered passing if all subtests either pass, fail as
#  expected, or are skipped. The tests are considered failing if any one of
#  the subtests (unexpectedly) fails.
<<@>@ M@>(Monad@<M@>, Out@<Char@, M@>, String@, Test@) { M@<Bool@>; }
Run = <<@>@ M@>(Monad@<M@> m, Out@<Char@, M@> out, String@ prefix, Test@ test) {
  test.?(
    case: {
      String@ name = Concat[prefix, test.case.name];
      Unit@ _ := m.do(out(FormatE|'@[%s]: '[String(name)]));

      TestResult@ tr = test.case.test(Unit);

      (Bool@, Stream@<Char@>) { M@<Bool@>; }
      Return = (Bool@ result, Stream@<Char@> output) { 
        Unit@ _ := m.do(out(output));
        m.return(result);
      };

      tr.?(
        pass: Return(True, StringE|'@PASS\n'),
        fail: Return(False, FormatE|'@FAIL: %s\n'[tr.fail]),
        expected_fail: Return(True, StringE|'@EXPECTED_FAIL\n'),
        skip: Return(True, FormatE|'@SKIP: %s\n'[tr.skip]));
    },
    suite: {
      String@ name = Concat[prefix, test.suite.name, Str|'.'];
      M@<Bool@> s, Test@ test := ForEach(test.suite.tests, m.return(True));
      Bool@ passing := m.do(s);
      Bool@ pass := m.do(Run(m, out, name, test));
      m.return(And(passing, pass));
    });
};

@(Run);
