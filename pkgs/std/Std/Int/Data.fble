# @module[/Std/Int/Data%]
#  The Data@ instance for Int@.

Data@, Bit@, 0, 1 .= /Std/Data%;
Int@ .= /Std/Int%;
Stream@, Do, Put .= /Std/Stream%;
Unit@ .= /Std/Unit%;

# @func[Data] Convert an Int@ to a data bit stream.
#  @arg[Int@][x] The integer to convert.
#  @returns[Stream@<Bit@>] The stream of bits describing the Int@.
Data@<Int@>
Data = (Int@ x)<@ S@>(S@ _empty, (Bit@, Stream@<Bit@>) { S@; } items) {
  x.?(
    n: items(0, {
      Unit@ _ := Do(Put(0));
      /Std/Int/IntP/Data%.DataR(x.n);
    }),
    0: items(0, Put(1)),
    p: items(1, /Std/Int/IntP/Data%.Data(x.p)));
};

@(Data);
