# @module[/Std/Random/Prng/Pure%]
#  Provides an Rng@ instance for Prng@ pseudo random number generators using a
#  pure state monad.

Int@, Add, Sub, Shl, Shr .= /Std/Int%;
Le .= /Std/Int/Cmp%;
Prng@ .= /Std/Random/Prng%;
Rng@ .= /Std/Random/Rng%;
Modify .= /Std/State%;
Pure@, Monad, State .= /Std/State/Pure%;
Unit@ .= /Std/Unit%;

# @func[Rng] Pure state monad Rng@ implementation of a Prng@.
#  @arg[@][S@] The state type for the pseudo random number generator.
#  @arg[Prng@<S@>][prng] Implementation of the pseudo random number generator.
#  @returns[Rng@<Pure@<S@>>]
#   A pure state monad based implementation of the Rng@ interface for the
#   pseudo random number generator.
#
#  Normally this is imported using the @l{Pure} function, which provides
#  convenient access to the monadic type and monad instance being used. For
#  example, to use the Rand48 linear congruential generator:
#
#  @code[fble] @
#   Prng(.Lfsr8) .= /Std/Random/Lfsr%;
#   Run .= /Std/State/Pure%;
#   M@, M(.Monad), Rng .= /Std/Random/Prng/Pure%.Pure(Prng);
#
#  You can now pass M and Rng to functions that expect an Rng@ like
#  @l{/Std/Bool/Random%.Uniform} and execute the resulting computation using
#  the pure state monad @l{Run} function.
#
#  See @l{/Std/Random/Prng%} for more examples.
<@ S@>(Prng@<S@>) { Rng@<Pure@<S@>>; }
Rng = <@ S@> (Prng@<S@> prng) {
  M@ = Pure@<S@>;
  M = Monad<S@>;
  S = State<S@>;

  (Int@) { M@<Int@>; } rand = (Int@ n) {
    S@ s := M.do(S.get);
    S@ next = prng.next(s);
    Unit@ _ := M.do(S.put(next));

    Int@ lo = prng.bits(next);
    Le(n, prng.n).?(true: {
      M.return(Shr(lo, Sub(prng.n, n)));
    });

    Int@ hi := M.do(rand(Sub(n, prng.n)));
    M.return(Add(Shl(hi, prng.n), lo));
  };

  (Int@, Int@) { M@<Unit@>; } feed = (Int@ n, Int@ x) {
    Modify(M, S, prng.feed(n, x));
  };

  @(rand, feed);
};

# @func[Pure] Stand alone implementation of pseudo random number generator.
#  @arg[@][S@] The state type for the pseudo random number generator.
#  @arg[Prng@<S@>][prng] Implementation of the pseudo random number generator.
#  @returns[...]
#   A collection monadic type M@, monad instance, state instance, and Rng
#   instance for the pure state monad implementation of the pseudo random
#   number generator.
#
#  For example, to use the Rand48 linear congruential generator:
#
#  @code[fble] @
#   Prng(.Lfsr8) .= /Std/Random/Lfsr%;
#   Run .= /Std/State/Pure%;
#   M@, M(.Monad), Rng .= /Std/Random/Prng/Pure%.Pure(Prng);
#
#  You can now pass M and Rng to functions that expect an Rng@ like
#  @l{/Std/Bool/Random%.Uniform} and execute the resulting computation using
#  the pure state monad @l{Run} function.
#
#  See @l{/Std/Random/Prng%} for more examples.
Pure = <@ S@>(Prng@<S@> prng) {
  @(M@: Pure@<S@>, Monad: Monad<S@>, State: State<S@>, Rng: Rng(prng));
};

@(Rng, Pure);
