# @module[/Std/Set%]
#  Implementation of a set of elements that works with any element type with a
#  @l{/Std/Data%.Data@} instance.
#
#  Insert and lookup are O(N) in the data length of the element. Iteration
#  traverses elements in the order defined by the @l{Data@} instance for the
#  element.
#
#  The typical way to use a set is to use struct import on the result of the
#  @l{Of} function, which provides types and functions specialized for the
#  given element type and data instance. For example, for a set of strings:
#
#  @code[fble] @
#   Set@, Empty, Add, Has .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Set@ m = Add(Empty, Str|'answer');
#   Set@ n = Add(m, Str|'question');
#   Bool@ has_answer = Has(n, Str|'answer');  # True
#
#  Additional functionality is provided in submodules:
#
#  @def[@l{/Std/Set/Eq%}] Instance of @l{Eq@} for sets.
#  @def[@l{/Std/Set/List%}] Construct sets from lists of elements.
#  @def[@l{/Std/Set/Show%}] Instance of @l{Show@} for sets.

Bool@, True, False .= /Std/Bool%;
Data@ .= /Std/Data%;
For@ .= /Std/For%;
Just, Nothing .= /Std/Maybe%;
Stream@ .= /Std/Stream%;
Unit@, Unit .= /Std/Unit%;

# @type[Set@] A set of elements.
#  Supporting any type T@ that implements Data@<T@>.
Set@ = <@ T@> { /Std/Map%.Map@<T@, Unit@>; };

# @func[Empty] The empty set.
#  @arg[@][T@] The type of values in the set.
#  @returns[Set@<T@>] An empty set.
#
#  For example:
#
#  @code[fble] @
#   Set@, Empty, Add, Has .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Set@ m = Add(Empty, Str|'answer');
#   Set@ n = Add(m, Str|'question');
#   Bool@ has_answer = Has(n, Str|'answer');  # True
Set@ Empty = <@ T@> { /Std/Map%.Empty<T@, Unit@>; };

# @func[IsEmpty] Test if a set is empty or not.
#  @arg[@][T@] The type of value in the set.
#  @arg[Set@<T@>][set] The set to check.
#  @returns[Bool@] True if the set is empty. False otherwise.
#
#  For example:
#   Set@, Empty, IsEmpty, Add, Has .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Bool@ true = IsEmpty(Empty);
#   Bool@ false = IsEmpty(Add(Empty, Str|'answer'));
<@ T@>(Set@<T@>) { Bool@; }
IsEmpty = <@ T@> { /Std/Map%.IsEmpty<T@, Unit@>; };

# @func[Has] Test if the set contains the given element.
#  @arg[@][T@] The type of value in the set.
#  @arg[Data@<T@>][data] The Data@ implementation for type T@.
#  @arg[Set@<T@>][set] The set to check.
#  @arg[T@][element] The element to check for.
#  @returns[Bool@] True if the set contains the given value, false otherwise.
#
#  Runtime complexity is O(N) in the length of the data bit stream for the
#  element. Behavior is undefined if the @l{Data@} instance doesn't satisfy
#  the prefix property (see @l{/Std/Data%}).
#
#  For example:
#
#  @code[fble] @
#   Set@, Empty, Add, Has .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Set@ m = Add(Empty, Str|'answer');
#   Set@ n = Add(m, Str|'question');
#   Bool@ has_answer = Has(n, Str|'answer');  # True
<@ T@>(Data@<T@>, Set@<T@>, T@) { Bool@; }
Has = <@ T@>(Data@<T@> data, Set@<T@> set, T@ element) {
  /Std/Map%.Get(data, set, element).?(just: True, nothing: False);
};

# @func[Add] Adds an element to a set.
#  @arg[@][T@] The element type.
#  @arg[Data@<K@>][data] The Data@ instance for the element type.
#  @arg[Set@<T@>][set] The set to add the element to.
#  @arg[T@][element] The element to add to the set.
#  @return[Set@<T@>] The set with the added element.
#
#  Runtime complexity is O(N) in the length of the data bit stream for the
#  element. Behavior is undefined if the @l{Data@} instances doesn't satisfy
#  the prefix property (see @l{/Std/Data%}).
#
#  For example:
#
#  @code[fble] @
#   Set@, Empty, Add, Has .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Set@ m = Add(Empty, Str|'answer');
#   Set@ n = Add(m, Str|'question');
#   Bool@ has_answer = Has(n, Str|'answer');  # True
<@ T@>(Data@<T@>, Set@<T@>, T@) { Set@<T@>; }
Add = <@ T@>(Data@<T@> data, Set@<T@> set, T@ element) {
  /Std/Map%.Put(data, set, element, Unit);
};

# @func[Remove] Remove an element from the set.
#  @arg[@][T@] The element type.
#  @arg[Data@<K@>][data] The Data@ instance for the element type.
#  @arg[Set@<T@>][set] The set to remove the element from.
#  @arg[T@][element] The element to remove from the set.
#  @return[Set@<T@>] The set with the element removed.
#
#  Runtime complexity is O(N) in the length of the data bit stream for the
#  element. Behavior is undefined if the @l{Data@} instances doesn't satisfy
#  the prefix property (see @l{/Std/Data%}).
#
#  For example:
#
#  @code[fble] @
#   Set@, Empty, Add, Has, Remove .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Set@ m = Add(Empty, Str|'answer');
#   Set@ n = Remove(m, Str|'answer');
#   Bool@ has_answer = Has(n, Str|'answer');  # False
<@ T@>(Data@<T@>, Set@<T@>, T@) { Set@<T@>; }
Remove = <@ T@>(Data@<T@> data) {
  /Std/Map%.Remove(data)<Unit@>;
};

# @func[Each] Visit each element of a set as a stream.
#  @arg[@][A@] The type of element in the set.
#  @arg[Set@<A@>][set] The set to convert.
#  @returns[Stream@<A@>] A stream of the values in the set.
#
#  The iteration order matches the order of the associated data streams
#  provided by the @l{Data@} instance used when adding elements to the set.
#
#  The @l{Each} function is best to use if you don't expect to have to visit
#  every element of the set. If you know you'll need to visit every element of
#  the set, @l{ForEach} provides a simpler interface.
#
#  For example, to check if there are any even integers in a set of integers:
#
#  @code[fble] @
#   Set@ set = ...;
#   Bool@ found = {
#     Unit@ _ := {
#       # Case for if the set has at least one element.
#       Unit@ _, Int@ element, (Unit@) { Bool@; } r := Each(set, Unit);
#       IsEven(element).?(true: True);
#       r(Unit);
#     };
#
#     # Case for is if the set is empty.
#     False;
#   };
#
#  See @l{/Std/Stream%} for more about traversing streams.
<@ A@>(Set@<A@>) { Stream@<A@>; }
Each = <@ A@>(Set@<A@> set) {
  /Std/Map%.Keys(set);
};

# @func[ForEach] Iterate over elements of a set.
#  @arg[@][T@] The element type.
#  @arg[Set@<T@>][set] The set to iterate over.
#  @returns[ForEach<T@>] A foreach loop iteration over the set elements.
#
#  The iteration goes over all elements in the set. If you want to break out
#  early, use the @l{Each} function instead.
#
#  For example, to count the number of even integers on a set of integers:
#
#  @code[fble] @
#   Set@ set = ...;
#   Int@ count = {
#     Int@ count, Int@ element := ForEach(set);
#     IsEven(element).?(true: Incr(count));
#     count;
#   };
<@ T@>(Set@<T@>) { For@<T@>; }
ForEach = <@ T@>(Set@<T@> set) {
  <@ S@>(S@ s, (S@, T@) { S@; } body) {
    S@ s, /Std/Map%.Entry@<T@, Unit@> e := /Std/Map%.ForEach(set, s);
    body(s, e.key);
  };
};

# @func[And] Intersection of two sets.
#  @arg[@][T@] The element type of the set.
#  @arg[Set@<T@>][a] The first set.
#  @arg[Set@<T@>][b] The second set.
#  @returns[Set@<T@>] The set of elements that appear in both input sets.
#
#  Behavior is undefined if you aren't using the same Data@ implementation for
#  both sets.
#
#  For example:
#
#  @code[fble] @
#   Set@, T, Has .= /Std/Set%.Of(/Std/Int/Data%.Data);
#   Set .= /Std/Set/List%.Of(T);
#
#   Set@ a = Set[Int|1, Int|2, Int|3];
#   Set@ b = Set[Int|3, Int|4, Int|5];
#   Set@ s = And(a, b);
#   Bool@ has_3 = Has(s, Int|3);  # True
#   Bool@ has_4 = Has(s, Int|4);  # False
<@ T@>(Set@<T@>, Set@<T@>) { Set@<T@>; }
And = <@ T@>(Set@<T@> a, Set@<T@> b) {
  T@ _, Unit@ _, Unit@ _ := /Std/Map%.Meet(a, b);
  Just(Unit);
};

# @func[Or] Union of two sets.
#  @arg[@][T@] The element type of the set.
#  @arg[Set@<T@>][a] The first set.
#  @arg[Set@<T@>][b] The second set.
#  @returns[Set@<T@>] The set of elements that appear in either input set.
#
#  Behavior is undefined if you aren't using the same Data@ implementation for
#  both sets.
#
#  For example:
#
#  @code[fble] @
#   Set@, T, Has .= /Std/Set%.Of(/Std/Int/Data%.Data);
#   Set .= /Std/Set/List%.Of(T);
#
#   Set@ a = Set[Int|1, Int|2, Int|3];
#   Set@ b = Set[Int|3, Int|4, Int|5];
#   Set@ s = Or(a, b);
#   Bool@ has_1 = Has(s, Int|1);  # True
#   Bool@ has_4 = Has(s, Int|4);  # True
<@ T@>(Set@<T@>, Set@<T@>) { Set@<T@>; }
Or = <@ T@>(Set@<T@> a, Set@<T@> b) {
  T@ _, Unit@ _, Unit@ _ := /Std/Map%.Join(a, b);
  Unit;
};

# @func[Diff] Difference between two sets.
#  @arg[@][T@] The element type of the set.
#  @arg[Set@<T@>][a] The first set.
#  @arg[Set@<T@>][b] The second set.
#  @returns[Set@<T@>]
#   The elements in the first set that are not also in the second set.
#
#  Behavior is undefined if you aren't using the same Data@ implementation for
#  both sets.
#
#  For example:
#
#  @code[fble] @
#   Set@, T, Has .= /Std/Set%.Of(/Std/Int/Data%.Data);
#   Set .= /Std/Set/List%.Of(T);
#
#   Set@ a = Set[Int|1, Int|2, Int|3];
#   Set@ b = Set[Int|3, Int|4, Int|5];
#   Set@ s = Diff(a, b);
#   Bool@ has_1 = Has(s, Int|1);  # True
#   Bool@ has_3 = Has(s, Int|3);  # False
<@ T@>(Set@<T@>, Set@<T@>) { Set@<T@>; }
Diff = <@ T@>(Set@<T@> a, Set@<T@> b) {
  T@ _, Unit@ _, Unit@ _ := /Std/Map%.Diff(a, b);
  Nothing<Unit@>;
};

# @func[Keep] Keeps only the specified elements of the set.
#  @arg[@][T@] The set element type.
#  @arg[Set@<T@>][set] The set to keep values from.
#  @arg[(T@) { Bool@; }][p] Predicate specifying which values to keep.
#  @returns[Set@<T@>]
#   The set with only those elements the predicate indicates to keep.
#
#  For example, to keep only the elements whose values are greater than 5:
#
#  @code[fble] @
#   Set@ set = Set[Int|1, Int|6, Int|13];
#   Set@ n = {
#    Int@ element := Keep(set);
#    Gt(element, Int|5);
#   };
#   Bool@ has_1 = Has(n, Int|1);    # False
#   Bool@ has_6 = Has(n, Int|6);    # True
<@ T@>(Set@<T@>, (T@) { Bool@; }) { Set@<T@>; }
Keep = <@ T@>(Set@<T@> set, (T@) { Bool@; } p) {
  T@ k, Unit@ _ := /Std/Map%.Keep(set);
  p(k);
};

# @func[Omit] Removes specified elements from the set.
#  @arg[@][T@] The set element type.
#  @arg[Set@<T@>][set] The set to keep values from.
#  @arg[(T@) { Bool@; }][p] Predicate specifying which values to remove.
#  @returns[Set@<T@>]
#   The set without those elements the predicate indicates to remove.
#
#  For example, to filter out the elements whose values are greater than 5:
#
#  @code[fble] @
#   Set@ set = Set[Int|1, Int|6, Int|13];
#   Set@ n = {
#    Int@ element := Omit(set);
#    Gt(element, Int|5);
#   };
#   Bool@ has_1 = Has(n, Int|1);    # True
#   Bool@ has_6 = Has(n, Int|6);    # False
<@ T@>(Set@<T@>, (T@) { Bool@; }) { Set@<T@>; }
Omit = <@ T@>(Set@<T@> set, (T@) { Bool@; } p) {
  T@ k, Unit@ _ := /Std/Map%.Omit(set);
  p(k);
};

# @func[Of] Set functions specialized for the given type.
#  @arg[@][T@] The set element type.
#  @arg[Data@<K@>][data] The Data@ instance to use with the set.
#  @returns[...] The Set methods specialized for the given type.
#
#  The recommended way to import and use the @l{/Std/Set%} functions is to use
#  a struct import on the result of calling @l{Of} with the element type and
#  @l{Data@} instance.
#
#  For example, if you want a set of strings:
#
#  @code[fble] @
#   Set@, Empty, Add, Has .= /Std/Set%.Of(/Std/String/Data%.Data);
#
#   Set@ m = Add(Empty, Str|'answer');
#   Set@ n = Add(m, Str|'question');
#   Bool@ has_answer = Has(n, Str|'answer');  # True
#
#  For convenience you can access the @l{Data@} instance under the name of
#  @l{T}, which can be useful for working with submodules like
#  @l{/Std/Set/List%}:
#
#  @code[fble] @
#   Set@, T, Has .= /Std/Set%.Of(/Std/Int/Data%.Data);
#   Set .= /Std/Set/List%.Of(T);
#
#   Set@ a = Set[Int|1, Int|2, Int|3];
Of = <@ T@>(Data@<T@> data) {
  @(
    Set@: Set@<T@>,
    T: data,
    Empty: Empty<T@>,
    IsEmpty: IsEmpty<T@>,
    Has: Has(data),
    Add: Add(data),
    Remove: Remove(data),
    Each: Each<T@>,
    ForEach: ForEach<T@>,
    And: And<T@>,
    Or: Or<T@>,
    Diff: Diff<T@>,
    Keep: Keep<T@>,
    Omit: Omit<T@>
  );
};

@(Set@, Empty, IsEmpty, Has, Add, Remove, Each, ForEach,
  And, Or, Diff, Keep, Omit, Of);
