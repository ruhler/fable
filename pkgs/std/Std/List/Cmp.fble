# @module[/Std/List/Cmp%]
#  The @l{Cmp@} instance for @l{List@}.

Cmp@, Compared@, Less, Equal, Greater .= /Std/Cmp%;
List@ .= /Std/List%;

# @func[Cmp] Provides a Cmp@ instance for lists.
#  @arg[@][A@] The type of element on the list.
#  @arg[Cmp@<A@>][cmp] How to compare list elements.
#  @returns[Cmp@<List@<A@>>] How to compare lists.
#
#  For example:
#
#  @code[fble] @
#   Cmp(/Std/Int/Cmp%.Cmp, List[1, 2, 4, 3, 2], List[1, 2, 3, 4, 5]);
#
#  Would return @l{Greater}, because the third element of the first list is
#  greater than the third element of the second list.
#
#  And:
#
#  @code[fble] @
#   Cmp(/Std/Int/Cmp%.Cmp, List[1, 2], List[1, 2, 3, 4, 5]);
#
#  Would return @l{Less} because the elements in the first list equal the
#  corresponding elements in the second list, but the first list is shorter.
<@ A@>(Cmp@<A@>) { Cmp@<List@<A@>>; }
Cmp = <@ A@>(Cmp@<A@> cmp) {
  Cmp@<List@<A@>>
  Cmp = (List@<A@> a, List@<A@> b) {
    a.?(empty: b.?(items: Less, empty: Equal));
    b.?(empty: Greater);

    Compared@ compared = cmp(a.items.head, b.items.head);
    compared.?(equal: Cmp(a.items.tail, b.items.tail));
    compared;
  };
  Cmp;
};

@(Cmp);
