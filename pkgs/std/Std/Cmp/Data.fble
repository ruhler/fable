# @module[/Std/Cmp/Data%]
#  The Data@ instance for Compared@.

Compared@ .= /Std/Cmp%;
Data@, Enum .= /Std/Data%;

# @func[Data] The Data@ instance for Compared@.
#  @arg[Compared@@][x] A value to convert to its corresponding data stream.
#  @returns[Stream@<Bit@>] A stream of bits representing the data.
#
#  The data stream has the order less < equal < greater.
#
#  See also @l{/Std/Data%} and @l{/Std/Map%}.
Data@<Compared@> Data = (Compared@ x) {
  # Pick order to match Cmp, which puts false < true.
  x.?(less: Enum|00, equal: Enum|01, greater: Enum|1);
};

@(Data);
