# @module[/Std/Maybe/Eq%]
#  The Eq@ instance for Maybe@ and other predicates involving Maybe@.

Bool@, True, False .= /Std/Bool%;
Eq@ .= /Std/Eq%;
Maybe@ .= /Std/Maybe%;

# @func[IsJust] Check if a value is present.
#  @arg[@][T@] The type of value.
#  @arg[Maybe@<T@>][maybe] The maybe to check.
#  @returns[Bool@] True if a value is present, false otherwise.
#
#  For example:
#
#  @code[fble] @
#   <@ T@>(T@, Maybe@<T@>) { T@; }
#   Default = <@ T@>(T@ default, Maybe@<T@> maybe) {
#     IsJust(maybe).?(true: JustGet(maybe));
#     default;
#   };
#
#  The @l{IsJust} function is provided for completeness or where boolean
#  predicates are expected. Normally you would access the @l{just} field
#  directly, as in:
#
#  @code[fble] @
#   <@ T@>(T@, Maybe@<T@>) { T@; }
#   Default = <@ T@>(T@ default, Maybe@<T@> maybe) {
#     maybe.?(just: maybe.just);
#     default;
#   };
<@ T@>(Maybe@<T@>) { Bool@; }
IsJust = <@ T@>(Maybe@<T@> maybe) {
  maybe.?(just: True);
  False;
};

# @func[IsNothing] Check if no value is present.
#  @arg[@][T@] The type of value.
#  @arg[Maybe@<T@>][maybe] The maybe to check.
#  @returns[Bool@] True if no value is present, false otherwise.
#
#  For example:
#
#  @code[fble] @
#   <@ T@>(T@, Maybe@<T@>) { T@; }
#   Default = <@ T@>(T@ default, Maybe@<T@> maybe) {
#     IsNothing(maybe).?(true: default);
#     JustGet(maybe));
#   };
#
#  The @l{IsNothing} function is provided for completeness or where boolean
#  predicates are expected. Normally you would access the @l{nothing} field
#  directly, as in:
#
#  @code[fble] @
#   <@ T@>(T@, Maybe@<T@>) { T@; }
#   Default = <@ T@>(T@ default, Maybe@<T@> maybe) {
#     maybe.?(nothing: default);
#     maybe.just;
#   };
<@ T@>(Maybe@<T@>) { Bool@; }
IsNothing = <@ T@>(Maybe@<T@> maybe) {
  maybe.?(nothing: True);
  False;
};

# @func[Eq] Check if two maybes are equal.
#  @arg[@][T@] The type of value.
#  @arg[Eq@<T@>][eq] Value equality.
#  @arg[Maybe@<T@>][a] The first maybe.
#  @arg[Maybe@<T@>][b] The second maybe.
#  @returns[Bool@] True if the maybes are equal, false otherwise.
#
#  For example, to check if two maybe integers are equal:
#
#  @code[fble] @
#   Eq@<Maybe@<Int@>> Eq = /Std/Maybe/Eq%.Eq(/Std/Int/Eq%.Eq);
#   Maybe@<Int@> a = ...;
#   Maybe@<Int@> b = ...;
#   Bool@ equal = Eq(a, b);
#
#  See @l{/Std/Eq%} for more about the @l{Eq@} interface.
<@ T@>(Eq@<T@>) { Eq@<Maybe@<T@>>; }
Eq = <@ T@>(Eq@<T@> eq, Maybe@<T@> a, Maybe@<T@> b) {
  a.?(nothing: b.?(nothing: True, : False));
  b.?(nothing: False);
  eq(a.just, b.just);
};

@(IsJust, IsNothing, Eq);
