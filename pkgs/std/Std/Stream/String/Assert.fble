# @module[/Std/Stream/String/Assert%]
#  Unit test assertion testing for expected stream output.

Char@ .= /Std/Char%;
AssertEquals .= /Std/Eq/Assert%;
Stream@ .= /Std/Stream%;
ToString .= /Std/Stream/String%;
String@ .= /Std/String%;
TestResult@ .= /Std/Test%;

# @func[AssertStream] Assert an stream generates the expected value.
#  @arg[String@][expected] The expected sequence of characters.
#  @arg[Stream@<Char@>][actual] The actual stream of characters.
#  @returns[TestResult@]
#   A passing test result if the actual stream of characters matches what's
#   expected. A failing test result otherwise.
#
#  For example:
#
#  @code[fble] @
#   OnAscii .= /Std/Char/Ascii%;
#   AssertStream = OnAscii(/Std/Stream/String/Assert%.AssertStream);
#   Show = /Std/List/Show%.Show(/Std/Int/Show%.Show);
#
#   Test|ShowList({
#     Unit@ _ := Lazy;
#     AssertStream|'[2, -12, 5]'(Show(List[Int|2, Neg(Int|12), Int|5]));
#   });
(String@, Stream@<Char@>) { TestResult@; }
AssertStream = (String@ expected, Stream@<Char@> actual) {
  AssertEquals(/Std/String/Eq%.Eq, /Std/String/Show%.Show,
    expected, ToString(actual));
};

@(AssertStream);
