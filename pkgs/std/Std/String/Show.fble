# @module[/Std/String/Show%]
#  The @l{Show@} instance for @l{String@}.

Char@ .= /Std/Char%;
FormatE .= /Std/Char/Ascii/Stream%;
U .= /Std/Char/Lit%;
End, Puts .= /Std/Stream%;
String .= /Std/Stream/String%;
Show@ .= /Std/Show%;
String@ .= /Std/String%;
Unit@ .= /Std/Unit%;

Char@ single_quote = U|27;

# @dev
#  @func[Chars] Shows the characters of a string without surrounding quotes.
#   Performs escaping of single quotes by replacing them with double single
#   quotes. For example, the string with the five characters @l{don't} is
#   shown as a sequence of 6 characters: @l{don''t}.
#
#   @arg[String@][x] The string to show.
#   @return[Stream@<Char@>]
#    The characters of the string without surrounding quotes.
Show@<String@> Chars = (String@ s) {
  s.?(empty: End<Char@>);

  Unit@ _ := Puts({
    Char@ c = s.items.head;
    /Std/Char/Eq%.Eq(c, single_quote).?(true: String[single_quote, single_quote]);
    String[c];
  });
  Chars(s.items.tail);
};

# @func[Show] Show a String@ value.
#  The value is shown with surrounding single quotes added and escaping of
#  single quotes inside the string. For example, the five character string
#  @l{don't} is output as a sequence of 8 characters: @l{'don''t'}.
#
#  @arg[String@][x] The value to show.
#  @returns[Stream@<Char@>] The shown string value, e.g. @l{'hello'}.
#
#  The code:
#
#  @code[fble] @
#   Stream@<Char@> output = Format|'This string value is: %s'[
#     /Std/String/Show%.Show(Str|hello)
#   ];
#
#  Would output:
#
#  @code[txt] @
#   This string value is: 'hello'
Show@<String@> Show = (String@ s) {
  FormatE|'\q%s\q'[Chars(s)];
};

@(Show);
