# @module[/Std/Stream%]
#  Types and utilities for streaming data out.

Lazy@ .= /Std/Lazy%;
Unit .= /Std/Unit%;

# @type@[Stream@] A computation that outputs a stream of values.
#  @arg[@][A@] The type of value to output.
#  @arg[@][S@] The type to stream the outputs into.
#  @arg[S@][empty] Called when the stream is empty.
#  @arg[(A@, Stream@<A@>) { S@; }][items] Called when the stream is not empty.
#  @returns[S@] The final result.
Stream@ = <@ A@> {
  Stream@ = <@ S@>(S@, (A@, Stream@) { S@; }) { S@; };
  Stream@;
};

# @value[Return] A computation that outputs nothing.
#  @type[Stream@]
Stream@ Return = <@ A@, @ S@>(S@ empty, (A@, Stream@<A@>) { S@; } _) {
  empty;
};

# @func[Do] Stream one thing after another.
#  @arg[@][A@] The type of values to output.
#  @arg[Stream@][ma] The first stream of outputs.
#  @arg[(Unit@) { Stream@; }][f] The next stream of outputs.
#  @return[Stream@]
#   A computation that streams out the first set of outputs, then calls the
#   function f to get the second set of outputs to stream.
<@ A@>(Stream@<A@>, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Do = <@ A@>(Stream@<A@> ma, Lazy@<Stream@<A@>> f) {
  <@ S@>(S@ empty, (A@, Stream@<A@>) { S@; } items) {
    ma(f(Unit, empty, items), items);
  };
};

# @func[DoM] Monadic Do for streams.
#  Applies a function to every element of a stream and streams out the
#  results.
#
#  @arg[@][A@] The type of element on the given stream.
#  @arg[Stream<A@>][stream] The stream to map over.
#  @arg[@][B@] The type of element on the returned stream.
#  @arg[(A@) { Stream<B@>; }][f] The function to apply.
#  @returns[Stream<B@>]
#   The list of elements f(a_i) for each a_i in the input stream.
<@ A@>(Stream@<A@>)<@ B@>((A@) { Stream@<B@>; }) { Stream@<B@>; }
DoM = <@ A@>(Stream@<A@> stream)<@ B@>((A@) { Stream@<B@>; } f) {
  <@ S@>(S@ empty, (B@, Stream@<B@>) { S@; } items) {
    A@ a, Stream@<A@> sa := stream(empty);
    f(a, DoM(sa, f, empty, items), items);
  };
};

# @func[Put] Output a single value.
#  @arg[@][A@] The type of values to output.
#  @arg[A@][v] The value to output.
#  @returns[Stream@] A computation that outputs the value.
<@ A@>(A@) { Stream@<A@>; }
Put = <@ A@>(A@ v)<@ S@>(S@ _empty, (A@, Stream@<A@>) { S@; } items) {
  items(v, Return<A@>);
};

# @func[ForEach] Iterate over elements of a stream.
#  @arg[@][A@] The type of element on the stream.
#  @arg[Stream@<A@>][stream] The stream of elements to iterate over.
#  @arg[@][B@] The type of data to return.
#  @arg[B@][base] The value to return for an empty list.
#  @arg[(A@, B@) { B@; }][body]
#   A function to update the value to return given the next element on the
#   stream.
#  @returns[B@]
#   The result of applying the body consecutively to the base value, once for
#   each element in the stream in order.
#
# Conceptually the behavior is like:
#
# @code[txt] @
#  B@ b = base
#  foreach x in stream:
#    b = body(x, b)
#  return b
<@ A@>(Stream@<A@>)<@ B@>(B@, (A@, B@) { B@; }) { B@; }
ForEach = <@ A@>(Stream@<A@> stream)<@ B@>(B@ base, (A@, B@) { B@; } body) {
  A@ head, Stream@<A@> tail := stream(base);
  ForEach(tail, body(head, base), body);
};

# @func[Map] Map a function over the elements of a stream.
#  @arg[@][A@] The output type of the original stream.
#  @arg[@][B@] The output type of the new stream.
#  @arg[(A@) { B@; }][f] Function to convert output values.
#  @arg[Stream@<A@>][stream] The original stream.
#  @return[Stream@<B@>] A new stream that outputs the target output type.
<@ A@, @ B@>((A@) { B@; }, Stream@<A@>) { Stream@<B@>; }
Map = <@ A@, @ B@>((A@) { B@; } f, Stream@<A@> s) {
  <@ S@>(S@ empty, (B@, Stream@<B@>) { S@; } items) {
    A@ a, Stream@<A@> t := s(empty);
    items(f(a), Map(f, t));
  };
};

@(Stream@, Return, Do, DoM, Put, ForEach, Map);
