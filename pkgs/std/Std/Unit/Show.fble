# @module[/Std/Unit/Show%]
#  The Show@ instance for Unit@.

String .= /Std/Char/Ascii/Stream%;
Show@ .= /Std/Show%;
Unit@ .= /Std/Unit%;

# @func[Show] Show a Unit@ value.
#  @arg[Unit@][x] The value to show.
#  @returns[Stream@<Char@>] The shown value @l{Unit}.
#
#  For example:
#
#  @code[fble] @
#   Stream@<Char@> output = Format|'This unit value is: %s'[
#     /Std/Unit/Show%.Show(Unit)
#   ];
#
#  Would output:
#
#  @code[txt] @
#   This unit value is: Unit
Show@<Unit@> Show = (Unit@ _x) {
  String|Unit;
};

@(Show);
