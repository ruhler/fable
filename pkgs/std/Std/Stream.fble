# @module[/Std/Stream%]
#  Types and utilities for streaming data out.

Lazy@ .= /Std/Lazy%;
Unit@, Unit .= /Std/Unit%;

# @type[Stream] An incrementally computed list of values.
#  @arg[@][A@] The type of element on the stream.
#  
#  @field[A@][head] The first item in the stream.
#  @field[Lazy@<Stream@<A@>>][tail]
#   Everything after the first item in the stream.
#
#  @field[@][items] A stream with one or more items.
#  @field[Unit@][empty] A stream with no items.
Stream@ = <@ A@> { 
  S@ = +(*(A@ head, Lazy@<S@> tail) items, Unit@ empty);
  S@;
};

# @value[End] The end of a stream.
#  @type[Stream@]
#
#  Also known as an empty stream.
Stream@ End = <@ A@> {
  Stream@<A@>(empty: Unit);
};

# @func[Put] Outputs a value to a stream.
#  @arg[@][A@] The type of items on the stream.
#  @arg[A@][head] A value to put to the stream.
#  @arg[Lazy@<Stream@<A@>>][tail]
#   A function to compute the rest of the stream.
#  @returns[Stream@<A@>]
#   A stream with @a[head] as the first value, followed by @a[tail].
#
#  Typically this is called using function bind syntax. For example:
#
#  @code[fble] @
#   Unit@ _ := Put(1);
#   Unit@ _ := Put(2);
#   Unit@ _ := Put(3);
#   End<Int@>;
<@ A@>(A@, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Put = <@ A@>(A@ head, Lazy@<Stream@<A@>> tail) {
  Stream@(items: @(head, tail));
};

# @func[Puts] Outputs a stream of values to a stream.
#  @arg[@][A@] The type of items on the stream.
#  @arg[Stream@<A@>][a] A stream of values to add to the stream.
#  @arg[Lazy@<Stream@<A@>>][tail]
#   A function to compute the rest of the stream.
#  @returns[Stream@<A@>]
#   A stream with all values from the given stream followed by followed by
#   @a[tail].
<@ A@>(Stream@<A@>, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Puts = <@ A@>(Stream@<A@> a, Lazy@<Stream@<A@>> b) {
  a.?(empty: b(Unit));
  Unit@ _ := Put(a.items.head);
  Puts(a.items.tail(Unit), b);
};

# @func[Return] Monadic Return for streams.
#  @arg[@][A@] The type of item on the stream.
#  @arg[A@][x] The value to return.
#  @returns[Stream@<A@>] A stream with the single given item.
<@ A@>(A@) { Stream@<A@>; }
Return = <@ A@>(A@ x) {
  Unit@ _ := Put(x);
  End<A@>;
};

# @func[Do] Monadic Do for streams.
#  Applies a function to every element of a stream and streams out the
#  results.
#
#  @arg[@][A@] The type of element on the given stream.
#  @arg[Stream<A@>][stream] The stream to map over.
#  @arg[@][B@] The type of element on the returned stream.
#  @arg[(A@) { Stream<B@>; }][f] The function to apply.
#  @returns[Stream<B@>]
#   The list of elements f(a_i) for each a_i in the input stream.
<@ A@>(Stream@<A@>)<@ B@>((A@) { Stream@<B@>; }) { Stream@<B@>; }
Do = <@ A@>(Stream@<A@> ma)<@ B@>((A@) { Stream@<B@>; } f) {
  ma.?(empty: End<B@>);
  Unit@ _ := Puts(f(ma.items.head));
  Do(ma.items.tail(Unit), f);
};

# @func[Map] Map a function over the elements of a stream.
#  @arg[@][A@] The output type of the original stream.
#  @arg[Stream@<A@>][stream] The original stream.
#  @arg[@][B@] The output type of the new stream.
#  @arg[(A@) { B@; }][f] Function to convert output values.
#  @return[Stream@<B@>] A new stream that outputs the target output type.
<@ A@>(Stream@<A@>)<@ B@>((A@) { B@; }) { Stream@<B@>; }
Map = <@ A@>(Stream@<A@> s)<@ B@>((A@) { B@; } f) {
  s.?(empty: End<B@>);
  Unit@ _ := Put(f(s.items.head));
  Map(s.items.tail(Unit), f);
};

# @func[ForEach] Iterate over elements of a stream.
#  @arg[@][A@] The type of element on the stream.
#  @arg[Stream@<A@>][stream] The stream of elements to iterate over.
#  @arg[@][B@] The type of data to return.
#  @arg[B@][base] The value to return for an empty list.
#  @arg[(A@, B@) { B@; }][body]
#   A function to update the value to return given the next element on the
#   stream.
#  @returns[B@]
#   The result of applying the body consecutively to the base value, once for
#   each element in the stream in order.
#
# Conceptually the behavior is like:
#
# @code[txt] @
#  B@ b = base
#  foreach x in stream:
#    b = body(x, b)
#  return b
<@ A@>(Stream@<A@>)<@ B@>(B@, (A@, B@) { B@; }) { B@; }
ForEach = <@ A@>(Stream@<A@> stream)<@ B@>(B@ base, (A@, B@) { B@; } body) {
  stream.?(empty: base);
  B@ next = body(stream.items.head, base);
  ForEach(stream.items.tail(Unit), next, body);
};

@(Stream@, End, Put, Puts, Return, Do, Map, ForEach);
