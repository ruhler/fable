# @module[/Std/Set/Show%]
#  The Show@ instance for Set@.

Char@ .= /Std/Char%;
Format, String .= /Std/Char/Ascii/Stream%;
Set@, ForEach .= /Std/Set%;
Show@ .= /Std/Show%;
Stream@, Puts .= /Std/Stream%;
Unit@ .= /Std/Unit%;

# @func[Show] Show a Set@ value.
#  For example:
#
#  @code[txt] @
#   { 1; 2; 3; }
#
#  @arg[@][T@] The element type.
#  @arg[Show@<T@>][show] How to show an element.
#  @arg[Set@<T@>][set] The set to show.
#  @returns[Stream@] The shown contents of the set.
<@ T@>(Show@<T@>) { Show@<Set@<T@>>; }
Show = <@ T@>(Show@<T@> show, Set@<T@> set) {
  Unit@ _ := Puts(ForEach(set, String|'{ ',
    (Stream@<Char@> s, T@ x) {
      Unit@ _ := Puts(s);
      Format|'%s; '[show(x)];
    }));
  String|'}';
};

@(Show);
