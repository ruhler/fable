
Int@ .= /Std/Int%;
Last .= /Std/List%;

Metrics@ .= /Pprof/Profile%;
Entry@, Table@ .= /Pprof/Query%;

# Get's the default metric value.
# Currently hard coded to the last.
# TODO: Take some argument as input to let the user choose which metric they
# are interested in.
(Metrics@) { Int@; } MetricOf = Last<Int@>;

# Sort a query results table.
(Table@) { Table@; }
Sort = (Table@ table) {
  Entry@ a, Entry@ b := /Std/List/Sort%.Sort(table);
  /Std/Int/Cmp%.Cmp(b.value, a.value);
};

@(MetricOf, Sort);

