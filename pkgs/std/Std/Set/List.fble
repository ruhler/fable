# @module[/Std/Set/List%}
#  Utility for constructing sets from lists of elements.

Data@ .= /Std/Data%;
List@ .= /Std/List%;
Set@, Add, Empty .= /Std/Set%;

# @func[Set] Construct a set from a list of elements.
#  @arg[@][T@] The type of element.
#  @arg[Data@<T@>][data] The Data@ instance for the element type.
#  @arg[List@<T@>>][elements] List of elements to populate the set with.
#  @returns[Set@<T@>] A set with the given elements.
#
#  This provides a convenient way to construct sets with known values. For
#  example, the set of squares less than 10:
#
#  @code[fble] @
#   Set@, T .= /Std/Set%.Of(/Std/Int/Data%.Data);
#   Set .= /Std/Set/List%.Of(T);
#   Set@ squares = Set[Int|1, Int|4, Int|9];
<@ T@>(Data@<T@>)(List@<T@>) { Set@<T@>; }
Set = <@ T@>(Data@<T@> data)(List@<T@> elements) {
  elements.?(empty: Empty<T@>);
  Add(data, Set(data, elements.items.tail), elements.items.head);
};

# @func[Of] Functions specialized for the given element type.
#  @arg[@][T@] The set element type.
#  @arg[Data@<K@>][data] The Data@ instance to use with the set.
#  @returns[...] The methods specialized for the given element type.
#
#  This is used to import the @l{Set} function for a specific element type.
#  For example:
#
#  @code[fble] @
#   Set@, T .= /Std/Set%.Of(/Std/Int/Data%.Data);
#   Set .= /Std/Set/List%.Of(T);
#   Set@ squares = Set[Int|1, Int|4, Int|9];
Of = <@ T@>(Data@<T@> data) {
  @(
    Set: Set(data)
  );
};

@(Set, Of);
