# @module[/Std/Bool/Show%]
#  The @l{Show@} instance for @l{Bool@}.

Bool@ .= /Std/Bool%;
String .= /Std/Char/Ascii/Stream%;
Show@ .= /Std/Show%;

# @func[Show] Show a @l{Bool@} value.
#  @arg[Bool@][x] The value to show.
#  @returns[Stream@<Char@>] The value shown as @l{True} or @l{False}.
#
#  For example:
#
#  @code[fble] @
#   Stream@<Char@> output = Format|'This bool value is: %s'[
#     /Std/Bool/Show%.Show(True)
#   ];
#
#  Would output:
#
#  @code[txt] @
#   This bool value is: True
Show@<Bool@> Show = (Bool@ x) {
  x.?(true: String|True, false: String|False);
};

@(Show);
