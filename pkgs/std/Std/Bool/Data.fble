# @module[/Std/Bool/Data%]
#  The Data@ instance for Bool.

Bool@ .= /Std/Bool%;
Data@, Enum .= /Std/Data%;

# @func[Data] The Data@ instance for Bool@.
#  @arg[Bool@][x] A value to convert to its corresponding data stream.
#  @returns[Stream@<Bit@>] A stream of bits representing the data.
#
#  The data stream has the order false < true.
#
#  See also @l{/Std/Data%} and @l{/Std/Map%}.
Data@<Bool@> Data = (Bool@ x) {
  x.?(true: Enum|1, false: Enum|0);
};

@(Data);
