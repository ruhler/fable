# @module[/Std/Char/Show%]
#  The Show@ instance for Char@.

And .= /Std/Bool%;
Char@, Char, Pos .= /Std/Char%;
Ascii .= /Std/Char/Ascii%;
Format .= /Std/Char/Ascii/Stream%;
Int@, Add, Sub, Incr .= /Std/Int%;
Le, Ge .= /Std/Int/Cmp%;
QR@, Div .= /Std/Int/Div%;
Int .= /Std/Int/Lit%;
IsZero .= /Std/Int/Sign%;
Show@ .= /Std/Show%;
Stream@, End, Puts, Return .= /Std/Stream%;
Unit@ .= /Std/Unit%;

# @func[Show] Show a Char@ value.
#  @arg[Char@][x] The value to show.
#  @returns[Stream@] The shown value.
Show@<Char@> Show = (Char@ x) {
  /Std/String/Show%.Show[x];
};

# @func[Unicode] Show a Char@ value in unicode U+ notation.
#  @arg[Char@][x] The character to show.
#  @returns[Stream@<Char@>]
#   Stream of characters represnting the input character in U+ notation: upper
#   case hex with minimum number of leading zeroes needed to have at least 4
#   hex digits.
Show@<Char@> Unicode = {
  Int@ offset = Sub(Pos(Ascii.A), Int|10);

  (Int@) { Char@; } Digit = (Int@ x) {
    Le(x, Int|9).?(true: Char(Add(x, Int|48)));
    Char(Add(x, offset));
  };

  # n is number of digits shown so far.
  # x is the number to show.
  # Pads to show at least 4 digits.
  (Int@, Int@) { Stream@<Char@>; }
  Digits = (Int@ n, Int@ x) {
    QR@ qr = Div(x, Int|16);
    Stream@<Char@> tail = {
      And(IsZero(qr.q), Ge(n, Int|3)).?(true: End<Char@>);
      Digits(Incr(n), qr.q);
    };
    Unit@ _ := Puts(tail);
    Return(Digit(qr.r));
  };

  (Char@ c) {
    Format|'U+%s'[Digits(Int|0, c.pos)];
  };
};

@(Show, Unicode);
