# @module[/Std/Int/Cmp%]
#  The @l{Cmp@} instance for @l{Int@}.
#
#  Useful both as a building block for implementing @l{Cmp@} for more complex
#  data types involving integer fields, and for standard integer comparison
#  operations @l{Le}, @l{Lt}, @l{Ge}, @l{Gt}, @l{Min}, @l{Max}, etc.
#
#  See @l{/Std/Cmp%.Cmp@} for more about the @l{Cmp@} interface and how to use
#  it.

Cmp@, Less, Equal, Greater .= /Std/Cmp%;
Int@ .= /Std/Int%;
CmpP(.Cmp) .= /Std/Int/IntP/Cmp%;

# @func[Cmp] The integer comparison operation.
#  @arg[Int@][a] The first operand.
#  @arg[Int@][b] The second operand.
#  @returns[Compared@] The result of comparing a to b.
#
#  For example:
#
#  @code[fble] @
#   /Std/List/Sort%.Sort(Cmp)[Int|4, Neg(Int|5), Int|0, Int|2, Int|1];
#
#  Would return a list equivalent to:
#
#  @code[fble] @
#   List[Neg(Int|5), Int|0, Int|1, Int|2, Int|4]
#  
Cmp@<Int@> Cmp = (Int@ a, Int@ b) {
  a.?(
      n: b.?(n: CmpP(b.n, a.n), 0: Less, p: Less),
      0: b.?(n: Greater, 0: Equal, p: Less),
      p: b.?(n: Greater, 0: Greater, p: CmpP(a.p, b.p)));
};

# @values[Lt, Le, Gt, Ge, InRange, Min, Max] Standard comparison operations.
#  See @l{/Std/Cmp%} for details on the comparison operations, which are
#  specialized here for the @l{Int@} type.
#
#  For example:
#
#  @code[fble] @
#   Lt(x, Int|4).?(true: String|'The integer is small');
#   String|'The integer is big';
Lt, Le, Gt, Ge, InRange, Min, Max .= /Std/Cmp%.Cmp(Cmp);

@(Cmp, Lt, Le, Gt, Ge, InRange, Min, Max);
