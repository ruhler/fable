# @module[/Std/Int/Stream%]
#  Utilities for producing streams of integers.

Int@, Incr .= /Std/Int%;
Lt .= /Std/Int/Cmp%;
Stream@, End, Put .= /Std/Stream%;
Unit@ .= /Std/Unit%;

# @func[Range] A stream of integers in the range [lo, hi).
#  @arg[Int@][lo] The start of the range, inclusive.
#  @arg[Int@][hi] The end of the range, exclusive.
#  @returns[Stream@<Int@>] The stream of integers from lo to hi.
#
#  The @l{Range} function can be used with @l{/Std/Stream%.For} to do integer
#  range based for loops. For example, to sum the integers from 0 to 9:
#
#  @code[fble] @
#   Int@ final_sum = {
#     Int@ sum, Int@ x := For(Range(Int|0, Int|10));
#     Add(sum, x);
#   };
#
#  To construct a list of pairs of integers in a 2x3 rectangular region:
#
#  @code[fble] @
#   Pair@ = *(Int@ x, Int@ y);
#   List@<Pair@> pairs = {
#     List@<Pair@> list, Int@ x := For(Range(Int|0, Int|2), Empty<Pair@>);
#     List@<Pair@> list, Int@ y := For(Range(Int|0, Int|3), list);
#     Items(Pair@(x, y), list);
#   };
#
#  Which constructs a list equivalent to:
#
#  @code[fble] @
#   List[
#     Pair@(0, 0), Pair@(0, 1), Pair@(0, 2),
#     Pair@(1, 0), Pair@(1, 1), Pair@(1, 2)
#   ];
(Int@, Int@) { Stream@<Int@>; }
Range = (Int@ lo, Int@ hi) {
  Lt(lo, hi).?(false: End<Int@>);
  Unit@ _ := Put(lo);
  Range(Incr(lo), hi);
};

@(Range);
