# @module[/Std/List%]
#  Defines the @l{List@} type and basic operations.
#
#  A @l{List@} is a singly linked list of elements parameterized by the
#  element type @l{T@}. Conceptually a list is either empty, or has a head
#  element followed by a tail list. We use the @l{Items} constructor for the
#  case where a list has at least one element.
#
#  The list type satisfies the fble language requirement for list
#  literals, which means you can pass list arguments via list literals. For
#  example, a function that takes a list as an argument could be called
#  normally as:
#
#  @code[fble] @
#   List@<Int@> mylist = ...;
#   f(mylist);
#
#  Or with list literals as:
#
#  @code[fble] @
#   f[Int|1, x, Int|3];
#
#  List literals can also be used if more function arguments are expected,
#  before or after the list. For example:
#
#  @code[fble] @
#   f(Int|5, mylist, True);
#
#  Could be called as:
#
#  @code[fble] @
#   f(Int|5)[Int|1, x, Int|3](True)
#
#  The @l{/Std/List%} module defines the @l{List@} type along with functions
#  for constructing and traversing lists. Additional functionality for
#  @l{List@} is provided in submodules:
#
#  @def[{/Std/List/Cmp%}]
#   Instance of @l{Cmp@} for @l{List@}
#  @def[{/Std/List/Count%}]
#   Counts elements on the list satisfying a property.
#  @def[{/Std/List/Data%}]
#   Instance of @l{Data@} for use of @l{List@} in map keys.
#  @def[{/Std/List/Eq%}]
#   Instance of @l{Eq@} for @l{List@}, along with functions for testing and
#   accessing sublists based on element equality.
#  @def[{/Std/List/Index%}]
#   Functions for getting the length of a list and accessing list elements by
#   index.
#  @def[{/Std/List/Maybe%}]
#   Conversions between @l{List@} and @l{Maybe@}.
#  @def[{/Std/List/Random%}]
#   Random shuffling of lists.
#  @def[{/Std/List/Search%}]
#   Functions for finding and filtering elements based on generic predicates.
#  @def[{/Std/List/Show%}]
#   Outputting lists in human readable form.
#  @def[{/Std/List/Sort%}]
#   Sorting lists.

For@ .= /Std/For%;
Unit@, Unit .= /Std/Unit%;

# @type[List@] A list of items.
#  The data structure layout provides constant time access to the first
#  element, linear access to later elements in the list.
#
#  @arg[@][T@] The type of element on the list.
#  @field[@][items]
#   A non-empty list.
#
#   @field[T@][head] The first item in the list.
#   @field[List@<T@>][tail] Everything after the first item in the list.
#
#  @field[Unit@][empty] A list with no items.
#
#  See the @l{List} function for a convenient way of constructing lists. It's
#  common to access the list fields directly when traversing lists. For
#  example, here's one way to sum the elements of a list of integers:
#
#  @code[fble] @
#   (List@<Int@>) { Int@; }
#   Sum = (List@<Int@> list) {
#     list.?(empty: 0);
#
#     Int@ head = list.items.head;
#     List@<Int@> tail = list.items.tail;
#     Add(head, Sum(tail));
#   };
List@ = <@ T@> {
  L@ = +(*(T@ head, L@ tail) items, Unit@ empty);
  L@;
};

# @func[List] The list literal.
#  The identity function on lists, which can be used for list literals. For
#  example, to construct a list with elements a, 4, and f(2):
#
#  @code[fble] @
#   List@<Int@> x = List[a, Int|4, f(Int|2)];
#
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The contents of the list.
#  @returns[List@<T@>] The given list.
<@ T@>(List@<T@>) { List@<T@>; }
List = <@ T@>(List@<T@> list) {
  list;
};

# @func[Items] Constructs a non-empty list.
#  @arg[@][T@] The type of element on the list.
#  @arg[T@][head] The first element of the list.
#  @arg[List@<T@>][tail] The remaining elements of the list.
#  @returns[List@<T>]
#   A new list consisting of the element @a[head] followed by the elements
#   from the list @a[tail].
#
#  For example, to construct a list of integers from lo to hi:
#
#  @code[fble] @
#   (Int@, Int@) { List@<Int@>; }
#   Range = (Int@ lo, Int@ hi) {
#    Eq(lo, hi).?(true: Empty<Int@>);
#    Items(lo, Range(Incr(lo), hi));
#   };
#
#  An explicit type is not required when calling @l{Items} because the element
#  type can be inferred from the first argument.
<@ T@>(T@, List@<T@>) { List@<T@>; }
Items = <@ T@>(T@ head, List@<T@> tail) {
  List@(items: @(head, tail));
};

# @func[Empty] The empty list.
#  @arg[@][T@] The type of element of the list.
#  @returns[List@<T@>] An empty list.
#
#  For example, to construct a list of integers from lo to hi:
#
#  @code[fble] @
#   (Int@, Int@) { List@<Int@>; }
#   Range = (Int@ lo, Int@ hi) {
#    Eq(lo, hi).?(true: Empty<Int@>);
#    Items(lo, Range(Incr(lo), hi));
#   };
#
#  You must provide the list element type explicitly with @l{Empty}, because
#  the element type cannot be inferred otherwise.
List@ Empty = <@ T@> {
  List@<T@>(empty: Unit);
};

# @func[Append] Appends one list to another.
#  @arg[@][T@] The type of elements in the list.
#  @arg[List@<T@>][a] The first list.
#  @arg[List@<T@>][b] The second list.
#  @returns[List@<T>]
#   A list containing the elements of @a[a] followed by the elements of @a[b].
#
#  Example:
#
#  @code[fble] @
#   List@<Planet@> terrestrial = List[Mercury, Venus, Earth, Mars];
#   List@<Planet@> giant = List[Jupiter, Saturn, Uranus, Neptune];
#   List@<Planet@> planets = Append(terrestrial, giant);
<@ T@>(List@<T@>, List@<T@>) { List@<T@>; }
Append = <@ T@>(List@<T@> a, List@<T@> b) {
  a.?(empty: b);
  Items(a.items.head, Append(a.items.tail, b));
};

# @func[Concat] Concatenates a list of lists together into a single list.
#  @arg[@][T@] The type of elements on the list.
#  @arg[List@<List@<T@>>][lists] A list of lists to concatenate.
#  @returns[List@<T@>] The elements of all the list of lists in order.
#
#  Example:
#
#  @code[fble] @
#   List@<Char@> space = List[tab, space, newline];
#   List@<Char@> digit = List[0, 1, 2];
#   List@<Char@> alpha = List[a, b, c];
#   List@<Char@> chars = Concat(List[space, digit, alpha]);
#
#  The previous example uses the @l{List} function to pass the list to
#  @l{Concat} for clarity. Normally we would call @l{Concat} itself using list
#  literal syntax for cases like this:
#
#  @code[fble] @
#   List@<Char@> chars = Concat[space, digit, alpha];
<@ T@>(List@<List@<T@>>) { List@<T@>; }
Concat = <@ T@>(List@<List@<T@>> lists) {
  lists.?(empty: Empty<T@>);
  Append(lists.items.head, Concat(lists.items.tail));
};

# @func[Join] Joins a list of lists together.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<List@<T@>>][lists] The list of lists to join.
#  @arg[List@<T@>][separator] Separator to put between the joined lists.
#  @returns[List@<T@>] The joined list.
#
#  This is most often used to join strings, which are lists of characters. For
#  example:
#
#  @code[fble] @
#   List@<List@<Char@>> days = List[Str|'Monday', Str|'Tuesday', Str|'Wednesday'];
#   List@<Char@> joined = Join(days, Str|', ');
#
#  Which produces a string equivalent to @l{Str|'Monday, Tuesday, Wednesday'};
<@ T@>(List@<List@<T@>>, List@<T@>) { List@<T@>; }
Join = <@ T@>(List@<List@<T@>> lists, List@<T@> separator) {
  lists.?(empty: Empty<T@>);
  lists.items.tail.?(empty: lists.items.head);
  Concat[lists.items.head, separator, Join(lists.items.tail, separator)];
};

# @func[Head] Returns the first element in a list.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The list to get the first element of.
#  @returns[T@] The first element on the list.
#  @sideeffects Behavior is undefined if the list is empty.
#
#  You should always check the list is not empty before calling the @l{Head}
#  function. For example:
#
#  @code[fble] @
#   (List@<Int@>) { Int@; }
#   Sum = (List@<Int@> list) {
#     list.?(empty: 0);
#     Add(Head(list), Sum(Tail(list)));
#   };
#
#  Often it is as convenient to access the @l{head} field directly:
#
#  @code[fble] @
#   (List@<Int@>) { Int@; }
#   Sum = (List@<Int@> list) {
#     list.?(empty: 0);
#     Add(list.items.head, Sum(list.items.tail));
#   };
#
#  See @l{/Std/List/Maybe%.Head} for a way to access the first element without
#  having to check if the list is empty before hand.
<@ T@>(List@<T@>) { T@; }
Head = <@ T@>(List@<T@> list) {
  list.items.head;
};

# @func[Tail] Returns all but the first element of a list.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The list to get all but the first element of.
#  @returns[List@<T@>] All but the first element in the list.
#  @sideeffects Behavior is undefined if the list is empty.
#
#  You should always check the list is not empty before calling the @l{Tail}
#  function. For example:
#
#  @code[fble] @
#   (List@<Int@>) { Int@; }
#   Sum = (List@<Int@> list) {
#     list.?(empty: 0);
#     Add(Head(list), Sum(Tail(list)));
#   };
#
#  Often it is as convenient to access the @l{tail} field directly:
#
#  @code[fble] @
#   (List@<Int@>) { Int@; }
#   Sum = (List@<Int@> list) {
#     list.?(empty: 0);
#     Add(list.items.head, Sum(list.items.tail));
#   };
<@ T@>(List@<T@>) { List@<T@>; }
Tail = <@ T@>(List@<T@> list) {
  list.items.tail;
};

# @func[Last] Returns the last element in a list.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The list to get the last element of.
#  @returns[T@] The last element in the list.
#  @sideeffects Behavior is undefined if the list is empty.
#
#  For example:
#
#  @code[fble] @
#   List@<String@> path = List[Str|usr, Str|bin, Str|cat];
#   String@ filename = Last(path);
#
#  You should always check the list is not empty before calling the @l{Last}
#  function. See @l{/Std/List/Maybe%.Last} for a way to access the last
#  element without having to check if the list is empty before hand.
<@ T@>(List@<T@>) { T@; }
Last = <@ T@>(List@<T@> list) {
  list.items.tail.?(empty: list.items.head);
  Last(list.items.tail);
};

# @func[Init] Returns all but the last element in a list.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The list to get the all but the last element of.
#  @returns[List@<T@>] All but the last element of the list.
#  @sideeffects Behavior is undefined if the list is empty.
#
#  For example:
#
#  @code[fble] @
#   List@<String@> path = List[Str|usr, Str|bin, Str|cat];
#   List@<String@> dir = Init(path);
#
#  Would produce a list equivalent to:
#
#  @code[fble] @
#   List@<String@> dir = List[Str|usr, Str|bin];
#
#  You should always check the list is not empty before calling the @l{Init}
#  function.
<@ T@>(List@<T@>) { List@<T@>; }
Init = <@ T@>(List@<T@> list) {
  list.items.tail.?(empty: Empty<T@>);
  Items(list.items.head, Init(list.items.tail));
};

# @func[Map] Applies a function to every element of a list.
#  @arg[@][A@] The type of element on the given list.
#  @arg[List@<A@>][list] The list to map over.
#  @arg[@][B@] The type of element on the returned list.
#  @arg[(A@) { B@; }][f] The function to apply.
#  @returns[List@<B@>]
#   The list of elements f(a_i) for each a_i in the input list.
#
#  For example, to take the square of each value of a list of integers:
#
#  @code[fble] @
#   List@<Int@> values = List[Int|1, Int|2, Int|3];
#   List@<Int@> squares = Map(values, Square);
#
#  Which would give the list @l{List[Int|1, Int|4, Int|9]};
#
#  Sometimes it's convenient to use function bind syntax. For example, the
#  example above could be rewritten with the @l{Square} function implemented
#  directly via bind syntax:
#
#  @code[fble] @
#   List@<Int@> values = List[Int|1, Int|2, Int|3];
#   List@<Int@> squares = {
#    Int@ x := Map(values);
#    Mul(x, x);
#   };
<@ A@>(List@<A@>)<@ B@>((A@) { B@; }) { List@<B@>; }
Map = <@ A@>(List@<A@> list)<@ B@>((A@) { B@; } f) {
  list.?(empty: Empty<B@>);
  Items(f(list.items.head), Map(list.items.tail, f));
};

# @func[Do] Monadic do for list types.
#  Applies a function to every element of a list and concatenates the list of
#  results.
#
#  @arg[@][A@] The type of element on the given list.
#  @arg[List@<A@>][list] The list to map over.
#  @arg[@][B@] The type of element on the returned list.
#  @arg[(A@) { List@<B@>; }][f] The function to apply.
#  @returns[List@<B@>]
#   The list of elements f(a_i) for each a_i in the input list.
#
#  It's most convenient to call @l{Do} using function bind syntax. For
#  example, to produce a list of coordinates in a 2 by 3 rectangular region:
#
#  @code[fble] @
#   Pair@ = *(Int@ x, Int@ y);
#   List@<Pair@> pairs = {
#     Int@ row := Do(Range(0, 2));
#     Int@ col := Do(Range(0, 3));
#     List[Pair@(col, row)];
#   };
#
#  Which produces the list:
#
#  @code[fble] @
#   List@<Pair@> pairs = List[
#     Pair@(0, 0), Pair@(1, 0), Pair@(2, 0), Pair@(3, 0),
#     Pair@(0, 1), Pair@(1, 1), Pair@(2, 1), Pair@(3, 1),
#     Pair@(0, 2), Pair@(1, 2), Pair@(2, 2), Pair@(3, 2)];
<@ A@>(List@<A@>)<@ B@>((A@) { List@<B@>; }) { List@<B@>; }
Do = <@ A@>(List@<A@> list)<@ B@>((A@) { List@<B@>; } f) {
  Concat(Map(list, f));
};

# @func[ForEach] Iterate over elements of a list.
#  @arg[@][A@] The type of element on the list.
#  @arg[List@<A@>][list] The list to iterate over.
#  @returns[For@<A@>] A for loop iteration over the list elements.
#
#  For example, to sum the integers on a list using @l{ForEach}:
#
#  @code[fble] @
#   List@<Int@> values = List[1, 2, 3, 4, 5];
#   Int@ sum = ForEach(values, 0, Add);
#
#  Often it is convenient to use function bind syntax. For example, to compute
#  the sum of squares of elements on a list:
#
#  @code[fble] @
#   List@<Int@> values = List[1, 2, 3, 4, 5];
#   Int@ final_sum = {
#     Int@ running_sum, Int@ x := ForEach(values, 0);
#     Add(running_sum, Mul(x, x));
#   };
#
#  See @l{/Std/For%.For@} for more explanation and  examples of how to use the
#  @l{For@} type.
<@ A@>(List@<A@>) { For@<A@>; }
ForEach = <@ A@>(List@<A@> list)<@ S@>(S@ s, (S@, A@) { S@; } body) {
  list.?(empty: s);
  ForEach(list.items.tail, body(s, list.items.head), body);
};

# @func[Reverse] Reverses the elements of a list.
#  @arg[@][T@] The type of element on the list.
#  @arg[List@<T@>][list] The list to reverse.
#  @returns[List@<T@>] The elements of the given list in reverse order.
#
#  For example, the following two lists are equivalent:
#
#  @code[fble] @
#   List@<Int@> first = List[5, 4, 3, 2, 1];
#   List@<Int@> second = Reverse[1, 2, 3, 4, 5];
<@ T@>(List@<T@>) { List@<T@>; }
Reverse = <@ T@>(List@<T@> list) {
  List@<T@> l, T@ x := ForEach(list, Empty<T@>);
  Items(x, l);
};

@(
  List@, List, Items, Empty,
  Append, Concat, Join,
  Head, Tail, Last, Init,
  Map, Do, ForEach, Reverse
);
