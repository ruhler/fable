# @module[/Std/Stream%]
#  Defines the @l{Stream@} type for producing and traversing streams of values
#  that are computed as you go.
#
#  The @l{/Std/Stream%} module defines the @l{Stream@} type and basic
#  utilities for constructing and iterating over streams. Additional
#  functionality fo @l{Stream@} is provided in submodules:
#
#  @def[@l{/Std/Stream/Debug%}] Debug output streams
#  @def[@l{/Std/Stream/In%}] Monadic input streams
#  @def[@l{/Std/Stream/List%}] Conversion between lists and streams
#  @def[@l{/Std/Stream/Null%}] Null output streams
#  @def[@l{/Std/Stream/Out%}] Monadic output streams
#  @def[@l{/Std/Stream/State%}] IO streams to and from pure state monads
#  @def[@l{/Std/Stream/String/Assert%}] Test assertions for streams
#  @def[@l{/Std/Stream/String%}] Conversions between strings and streams
#  @def[@l{/Std/Stream/Test%}] Test output streams.

For@ .= /Std/For%;
Lazy@ .= /Std/Lazy%;
Unit .= /Std/Unit%;

# @type[Stream@] A stream of elements for traversal.
#  Elements are traversed from the beginning of the stream. You can traverse
#  through all the elements of the stream, or you can break out of the
#  traversal early. Later elements of the stream are not computed until/unless
#  you traverse all the way through to them.
#
#  @arg[@][A@] The type of element on the stream.
#  @arg[@][S@] The traversal state type.
#  @arg[S@][s] The traversal state.
#  @arg[(S@, A@, (S@) { R@; }) { R@; }][put]
#   Function called with the next item in the stream.
#
#   @arg[S@][s] The traversal state.
#   @arg[A@][x] The next item in the stream.
#   @arg[(S@) { R@; }][r]
#    Function to continue traversing the rest of the elements of the stream.
#    You can call this to continue traversing the stream, or ignore it to
#    return a value early without traversing any more of the stream.
#   @returns[R@] The final result of traversal.
#  @arg[(S@) { R@; }][return]
#   Function called when the end of the stream is reached.
#
#   @arg[S@][s] The traversal state.
#   @returns[R@] The final result of traversal.
#  @returns The final result of traversal.
#
#  Here's an example of how you could produce a stream of boolean values
#  @l{True}, @l{True}, @l{False} using the raw @l{Stream@} type, though
#  often it's easier to use the @l{Put}, @l{End}, and @l{Return} helper
#  functions:
#
#  @code[fble] @
#   Stream@<Bool@> bools = 
#     <@ S@>(S@ s)<@ R@>((S@, Bool@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
#       S@ s := put(s, True);
#       S@ s := put(s, True);
#       S@ s := put(s, False);
#       return(s);
#     };
#
#  To traverse over the elements of a stream, you supply the put and return
#  functions as arguments to the stream value. For example, to test if the
#  number of @l{True} values in a stream before the first @l{False} value is
#  odd or even:
#
#  @code[fble] @
#   S@ = Int@;      # Count of true values at front of stream.
#   R@ = Bool@;     # Whether that count is odd or even.
#   put = (S@ count, Bool@ x, (S@) { R@; } r) {
#     x.?(true: r(Incr(count)));
#     count;
#   };
#   return = (S@ final_count) {
#     Eq(1, Mod(final_count, 2));
#   };
#
#   Stream@<Bool@> bools = ...;
#   Bool@ starts_with_odd_number_of_trues = bools(0, put, return);
#
#  To cut down on the boiler plate of defining and passing these functions, we
#  often make use of bind syntax to traverse over elements of the stream.
#  Here's the same example as above expressed using function bind syntax:
#
#  @code[fble] @
#   Stream@<Bool@> bools = ...;
#   Bool@ starts_with_odd_number_of_trues = {
#     Bool@ final_count := {
#       Int@ count, Bool@ x, (Int@) { Bool@; } r := bools(0);
#       x.?(true: r(Incr(count)));
#       count;
#     };
#     Eq(1, Mod(final_count, 2));
#   };
#
#  Notice that we only call the function @l{r} if we want to continue
#  traversing through the next elements of the stream. To break out early, we
#  are directly returning @l{count} from the @l{put} function. This way you
#  can avoid having to evaluate the entire stream if you only care about some
#  of the elements at the front.
Stream@ = <@ A@> { 
  <@ S@>(S@)<@ R@>(
    (S@, A@, (S@) { R@; }) { R@; },
    (S@) { R@; }
  ) { R@; };
};

# @func[End] Indicate the end of a stream.
#  @arg[@][A@] The type of element on the stream.
#  @returns[Stream@<A@>] An empty stream.
#
#  Used in construction of streams. For example, to construct a stream with
#  values @l{1}, @l{2}, then @l{3}:
#
#  @code[fble] @
#   Stream@<Int@> stream = {
#     Unit@ _ := Put(1);
#     Unit@ _ := Put(2);
#     Unit@ _ := Put(3);
#     End<Int@>;
#   };
Stream@ End = <@ A@> {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } _put, (S@) { R@; } return) {
    return(s);
  };
};

# @func[Put] Constructs a stream with at least one value.
#  @arg[@][A@] The type of items on the stream.
#  @arg[A@][head] The first value to put on the stream.
#  @arg[Lazy@<Stream@<A@>>][tail]
#   A function to compute the rest of the values of the stream.
#  @returns[Stream@<A@>]
#   A stream with @a[head] as the first value, followed by all the elements of
#   @a[tail].
#
#  Typically this is called using function bind syntax. For example:
#
#  @code[fble] @
#   Stream@<Int@> stream = {
#     Unit@ _ := Put(1);
#     Unit@ _ := Put(2);
#     Unit@ _ := Put(3);
#     End<Int@>;
#   };
<@ A@>(A@, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Put = <@ A@>(A@ head, Lazy@<Stream@<A@>> tail) {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
    S@ s := put(s, head);
    tail(Unit, s, put, return);
  };
};

# @func[Puts] Outputs a stream of values to a stream.
#  @arg[@][A@] The type of items on the stream.
#  @arg[Stream@<A@>][a]
#   A stream of values to add to the front of the stream.
#  @arg[Lazy@<Stream@<A@>>][tail]
#   A function to compute the rest of the stream.
#  @returns[Stream@<A@>]
#   A stream with all values from the given stream followed by all the values
#   from the @a[tail] stream.
#
#  This is like @l{Put}, but puts multiple values at once. Used for appendin a
#  stream to another stream. For example, to append two streams @l{a} and
#  @l{b}:
#
#  @code[fble] @
#   Stream@<Int@> appended = {
#     Unit@ _ := Puts(a);
#     Unit@ _ := Puts(b);
#     End<Int@>;
#   };
<@ A@>(Stream@<A@>, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Puts = <@ A@>(Stream@<A@> a, Lazy@<Stream@<A@>> b) {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
    S@ s := a(s, put);
    b(Unit, s, put, return);
  };
};

# @func[Return] Constructs a stream with a single element.
#  This is a monadic return function for the @l{Stream@} type.
#
#  @arg[@][A@] The type of item on the stream.
#  @arg[A@][x] The single element to put on the stream.
#  @returns[Stream@<A@>] A stream with the single given element.
#
#  For example, to construct the stream of values @l{1}, @l{2}, @l{3}:
#
#  @code[fble] @
#   Stream@<Int@> stream = {
#     Unit@ _ := Put(1);
#     Unit@ _ := Put(2);
#     Return(3);
#   };
<@ A@>(A@) { Stream@<A@>; }
Return = <@ A@>(A@ x) {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
    put(s, x, return);
  };
};

# @func[Do] Monadic do for streams.
#  Applies a function to every element of a stream and streams out the
#  results.
#
#  @arg[@][A@] The type of element on the given stream.
#  @arg[Stream<A@>][stream] The stream to map over.
#  @arg[@][B@] The type of element on the returned stream.
#  @arg[(A@) { Stream<B@>; }][f] The function to apply.
#  @returns[Stream<B@>]
#   The list of elements f(a_i) for each a_i in the input stream.
#
#  For example, to produce a stream of pairs (x, y) with x ranging from 0 to 3
#  and y ranging from 0 to 4, in the order (0, 0), (0, 1), (0, 2), ...
#
#  @code[fble] @
#   Range .= /Std/Int/Stream%;
#   Stream@<*(Int@ x, Int@ y)> pairs = {
#     Int@ x := Do(Range(0, 3));
#     Int@ y := Do(Range(0, 4));
#     Return(@(x, y));
#   };
<@ A@>(Stream@<A@>)<@ B@>((A@) { Stream@<B@>; }) { Stream@<B@>; }
Do = <@ A@>(Stream@<A@> ma)<@ B@>((A@) { Stream@<B@>; } f) {
  <@ S@>(S@ s)<@ R@>((S@, B@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
    S@ s := {
      S@ s, A@ a, (S@) { R@; } r := ma(s);
      f(a, s, put, r);
    };
    return(s);
  };
};

# @func[Map] Applies a function to each element of the stream.
#  @arg[@][A@] The element type of the original stream.
#  @arg[Stream@<A@>][stream] The original stream.
#  @arg[@][B@] The element type of the new stream.
#  @arg[(A@) { B@; }][f] Function to convert elements.
#  @return[Stream@<B@>]
#   The original stream with the function @l{f} applied to each element.
#
#  For example, to extra the @l{x} coordinates from a stream of pairs:
#
#  @code[fble] @
#   Pair@ = *(Int@ x, Int@ y);
#   GetX = (Pair@ pair) { pair.x; };
#   Stream@<Pair@> pairs = ...;
#   Stream@<Int@> xs = Map(pairs, GetX);
#
#  Or using function bind syntax:
#
#  @code[fble] @
#   Pair@ = *(Int@ x, Int@ y);
#   Stream@<Pair@> pairs = ...;
#   Stream@<Int@> xs = {
#     Pair@ pair := Map(pairs);
#     pair.x;
#   };
<@ A@>(Stream@<A@>)<@ B@>((A@) { B@; }) { Stream@<B@>; }
Map = <@ A@>(Stream@<A@> ma)<@ B@>((A@) { B@; } f) {
  <@ S@>(S@ s)<@ R@>((S@, B@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
    S@ s := {
      S@ s, A@ a, (S@) { R@; } r := ma(s);
      put(s, f(a), r);
    };
    return(s);
  };
};

# @func[For] Iterate over elements of a stream.
#  @arg[@][A@] The type of element on the stream.
#  @arg[Stream<A@>][stream] The stream to iterate over.
#  @returns[For@<A@>] A for loop iteration over the stream elements.
#
#  For example, to sum the elements of an integer stream:
#
#  @code[fble] @
#   Stream@<Int@> values = ...;
#   Int@ final_sum = {
#     Int@ sum, Int@ x := For(values);
#     Add(sum, x);
#   };
#
#  See @l{/Std/For%.For@} for more about the @l{For@} type.
<@ A@>(Stream@<A@>) { For@<A@>; }
For = <@ A@>(Stream@<A@> stream)<@ S@>(S@ s, (S@, A@) { S@; } body) {
  S@ s := {
    S@ s, A@ x, (S@) { S@; } r := stream(s);
    r(body(s, x));
  };
  s;
};

@(Stream@, End, Put, Puts, Return, Do, Map, For);
