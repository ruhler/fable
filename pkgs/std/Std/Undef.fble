# @module[/Std/Undef%]
#  Provides a standard way to explicitly express undefined behavior in code.
#
#  For example, imagine you are implementing integer division and need to do
#  something in case of divide by zero, but the specification for that case is
#  undefined.
#
#  @code[fble@]
#   divisor.?(0: ???);
#
#  @l{/Std/Undef%} defines an @l{Undef@} type with a single @l{undef} field
#  and undefined value @l{Undef} of that type. If you try to access the
#  @l{undef} field of @l{Undef}, the program will crash with an undefined
#  struct access error.
#
#  One way to use @l{/Std/Undef%} to explicitly express undefined behavior is
#  to directly access the @l{undef} field. The type argument for the field is
#  the type of value to produce to satisfy the compiler. For example:
#
#  @code[fble@]
#   # Divide by zero is undefined.
#   divisor.?(0: /Std/Undef%.Undef.undef<Int@>)
#
#  Another approach is to define a named undefined value, typically at module
#  level scope, where the name serves to document what about the behavior is
#  undefined. For example:
#
#  @code[fble@]
#   DivideByZero = /Std/Undef%.Undef;
#   ...
#   divisor.?(0: DivideByZero.undef<Int@>)

Unit@, Unit .= /Std/Unit%;

# @union[Undef@] Type used for indicating undefined behavior.
#  @field[Unit@][_] Field used for the actual value of the Undef@. Do not use.
#  @field[<@ T@> { T@; }][undef]
#   Field access which results in undefined behavior. 
Undef@ = +(Unit@ _, <@ T@> { T@; } undef);

# @value[Undef] An undefined value.
#  @type[Undef@]
#
#  Any attempt to access the @l{undef} field of this value will result in an
#  undefined struct access error.
Undef@ Undef = Undef@(_: Unit);

@(Undef@, Undef);
