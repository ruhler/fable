# @module[/Std/Int/Data%]
#  The Data@ instance for Int@.

Data@, Bit@, 0, 1 .= /Std/Data%;
Int@ .= /Std/Int%;

# @func[Data] Convert an Int@ to a data bit stream.
#  @arg[Int@][x] A value to convert to its corresponding data stream.
#  @returns[Stream@<Bit@>] A stream of bits representing the data.
#
#  See also @l{/Std/Data%} and @l{/Std/Map%}.
Data@<Int@>
Data = (Int@ x) {
  <@ S@>(S@ s)<@ R@>((S@, Bit@, (S@) { R@; }) { R@; } put, (S@) { R@; } return) {
    x.?(
      n: {
        S@ s := put(s, 0);
        S@ s := put(s, 0);
        /Std/Int/IntP/Data%.DataR(x.n, s, put, return);
      },
      0: {
        S@ s := put(s, 0);
        S@ s := put(s, 1);
        return(s);
      },
      p: {
        S@ s := put(s, 1);
        /Std/Int/IntP/Data%.Data(x.p, s, put, return);
      });
  };
};

@(Data);
