# @module[/Std/Stream%]
#  Types and utilities for streaming data out.

Lazy@ .= /Std/Lazy%;
Unit .= /Std/Unit%;

# @type[Stream] A stream of elements for traversal.
#  Elements are traversed from the beginning of the stream. You can traverse
#  through all the elements of the stream, or you can break out of the
#  traversal early. Later elements of the stream are not computed until/unless
#  you traverse all the way through to them.
#
#  @arg[@][A@] The type of element on the stream.
#  @arg[@][S@] The traversal state type.
#  @arg[S@][s] The traversal state.
#  @arg[(S@, A@, (S@) { R@; }) { R@; }][onItem]
#   Function called for the next item in the stream.
#
#   @arg[S@][s] The traversal state.
#   @arg[A@][x] The next item in the stream.
#   @arg[(S@) { R@; }][r]
#    Function to continue traversing the rest of the elements of the stream.
#    You can call this to continue traversing the stream, or ignore it to
#    return a value early without traversing any more of the stream.
#   @returns[R@] The final result of traversal.
#  @arg[(S@) { R@; }][onEmpty]
#   Function called when the end of the stream is reached.
#
#   @arg[S@][s] The traversal state.
#   @returns[R@] The final result of traversal.
#  @returns The final result of traversal.
#
#  If you want to be clever when traversing a stream, you can use function
#  bind syntax to provide implementations for onItem and onEmpty. Instead of:
#
#  @code[fble] @
#   onItem = (S@ s, A@ x, (S@) { R@; } r) {
#     # on item code here ...
#   };
#   onEmpty = (S@ s) {
#     # on empty code here ...
#   };
#   stream(s, onItem, onEmpty);
#
#  You could write:
#   
#  @code[fble] @
#   S@ s := {
#     S@ s, A@ x, (S@) { R@; } r := stream(s);
#     # on item code here ...
#   };
#   # on empty code here ...
Stream@ = <@ A@> { 
  <@ S@>(S@)<@ R@>(
    (S@, A@, (S@) { R@; }) { R@; },
    (S@) { R@; }
  ) { R@; };
};

# @value[End] The end of a stream.
#  @type[Stream@]
#
#  Also known as an empty stream.
Stream@ End = <@ A@> {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } _onItem, (S@) { R@; } onEmpty) {
    onEmpty(s);
  };
};

# @func[Put] Outputs a value to a stream.
#  @arg[@][A@] The type of items on the stream.
#  @arg[A@][head] A value to put to the stream.
#  @arg[Lazy@<Stream@<A@>>][tail]
#   A function to compute the rest of the stream.
#  @returns[Stream@<A@>]
#   A stream with @a[head] as the first value, followed by @a[tail].
#
#  Typically this is called using function bind syntax. For example:
#
#  @code[fble] @
#   Unit@ _ := Put(1);
#   Unit@ _ := Put(2);
#   Unit@ _ := Put(3);
#   End<Int@>;
<@ A@>(A@, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Put = <@ A@>(A@ head, Lazy@<Stream@<A@>> tail) {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } onItem, (S@) { R@; } onEmpty) {
    S@ s := onItem(s, head);
    tail(Unit, s, onItem, onEmpty);
  };
};

# @func[Puts] Outputs a stream of values to a stream.
#  @arg[@][A@] The type of items on the stream.
#  @arg[Stream@<A@>][a] A stream of values to add to the stream.
#  @arg[Lazy@<Stream@<A@>>][tail]
#   A function to compute the rest of the stream.
#  @returns[Stream@<A@>]
#   A stream with all values from the given stream followed by followed by
#   @a[tail].
<@ A@>(Stream@<A@>, Lazy@<Stream@<A@>>) { Stream@<A@>; }
Puts = <@ A@>(Stream@<A@> a, Lazy@<Stream@<A@>> b) {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } onItem, (S@) { R@; } onEmpty) {
    S@ s := a(s, onItem);
    b(Unit, s, onItem, onEmpty);
  };
};

# @func[Return] Monadic Return for streams.
#  @arg[@][A@] The type of item on the stream.
#  @arg[A@][x] The value to return.
#  @returns[Stream@<A@>] A stream with the single given item.
<@ A@>(A@) { Stream@<A@>; }
Return = <@ A@>(A@ x) {
  <@ S@>(S@ s)<@ R@>((S@, A@, (S@) { R@; }) { R@; } onItem, (S@) { R@; } onEmpty) {
    onItem(s, x, onEmpty);
  };
};

# @func[Do] Monadic Do for streams.
#  Applies a function to every element of a stream and streams out the
#  results.
#
#  @arg[@][A@] The type of element on the given stream.
#  @arg[Stream<A@>][stream] The stream to map over.
#  @arg[@][B@] The type of element on the returned stream.
#  @arg[(A@) { Stream<B@>; }][f] The function to apply.
#  @returns[Stream<B@>]
#   The list of elements f(a_i) for each a_i in the input stream.
<@ A@>(Stream@<A@>)<@ B@>((A@) { Stream@<B@>; }) { Stream@<B@>; }
Do = <@ A@>(Stream@<A@> ma)<@ B@>((A@) { Stream@<B@>; } f) {
  <@ S@>(S@ s)<@ R@>((S@, B@, (S@) { R@; }) { R@; } onItem, (S@) { R@; } onEmpty) {
    S@ s := {
      S@ s, A@ a, (S@) { R@; } r := ma(s);
      f(a, s, onItem, r);
    };
    onEmpty(s);
  };
};

# @func[Map] Map a function over the elements of a stream.
#  @arg[@][A@] The output type of the original stream.
#  @arg[Stream@<A@>][stream] The original stream.
#  @arg[@][B@] The output type of the new stream.
#  @arg[(A@) { B@; }][f] Function to convert output values.
#  @return[Stream@<B@>] A new stream that outputs the target output type.
<@ A@>(Stream@<A@>)<@ B@>((A@) { B@; }) { Stream@<B@>; }
Map = <@ A@>(Stream@<A@> ma)<@ B@>((A@) { B@; } f) {
  <@ S@>(S@ s)<@ R@>((S@, B@, (S@) { R@; }) { R@; } onItem, (S@) { R@; } onEmpty) {
    S@ s := {
      S@ s, A@ a, (S@) { R@; } r := ma(s);
      onItem(s, f(a), r);
    };
    onEmpty(s);
  };
};

@(Stream@, End, Put, Puts, Return, Do, Map);
