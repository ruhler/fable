# @module[/Std/Int/Div%]
#  Division of integers.

Int@, Decr, Neg, Sub, 0 .= /Std/Int%;

P = /Std/Int/IntP/Div%;

# @struct[QR@] Quotient and remainder.
#  @field[Int@][q] The quotient of division.
#  @field[Int@][r] The remainder of division.
QR@ = *(Int@ q, Int@ r);

/Std/Undef%.Undef@ DivideByZero = /Std/Undef%.Undef;

# @func[Div] Floored integer division.
#  @arg[IntP@][a] The first operand.
#  @arg[IntP@][b] The second operand.
#  @returns[QR@] The quotient and remainder of division.
#
#  Produces the quotient @l{q} and remainder @l{r} of integer division
#  @l{a/b} such that:
#
#  @code[txt] @
#   a = b*q + r, r < b, where q = floor(a/b)
#
#  The remainder r has the same sign as the divisor b, which has the nice
#  property that a/-b = -a/b and the remainder is always between 0 (inclusive)
#  and b (exclusive).
#
#  Behavior is undefined if the divisor b is 0.
#
#  You can access the returned quotient and remainder fields directly from the
#  returned struct value:
#
#  @code[fble] @
#   QR@ qr = Div(5, 3);
#   Format|'5 / 3 has quotient %s and remainder %s'[
#     /Std/Int/Show%.Show(qr.q),
#     /Std/Int/Show%.Show(qr.r)
#   ];
#
#  You can also use struct import:
#
#  @code[fble] @
#   Int@ q, Int@ r .= Div(5, 3);
#   Format|'5 / 3 has quotient %s and remainder %s'[
#     /Std/Int/Show%.Show(q),
#     /Std/Int/Show%.Show(r)
#   ];
#
#  In both examples above, the formatted output would be:
#
#  @code[txt] @
#   5 / 3 has quotient 1 and remainder 2
(Int@, Int@) { QR@; } Div = (Int@ a, Int@ b) {
  b.?(
    n: {
      QR@ qr = Div(Neg(a), Neg(b));
      @(q: qr.q, r: Neg(qr.r));
    },
    0: DivideByZero.undef<QR@>,
    p: {
      a.?(
        n: {
          P.QR@ qr = P.Div(a.n, b.p);
          Int@ q = Neg(qr.q);
          qr.r.?(0: @(q: q, r: 0));
          @(q: Decr(q), r: Sub(b, qr.r));
        },
        0: @(q: 0, r: 0),
        p: P.Div(a.p, b.p));
      });
};

# @func[Quot] The quotient of floored integer division.
#  @arg[IntP@][a] The first operand.
#  @arg[IntP@][b] The second operand.
#  @returns[QR@] The quotient of floored division of a by b.
#
#  Computes the division a/b, ignoring the remainder. Uses floored division
#  for consistency with the @l{Div} function, which means negative results
#  round down.
#
#  Behavior is undefined if the divisor b is 0.
#
#  For example:
#
#  @code[fble] @
#   Int@ three = Quot(Int|11, Int|3);
#   Int@ minus_four = Quot(Int|11, Neg(Int|3));
(Int@, Int@) { Int@; } Quot = (Int@ a, Int@ b) {
  Div(a, b).q;
};

# @func[Mod] The modulus operation.
#  @arg[IntP@][a] The first operand.
#  @arg[IntP@][b] The second operand.
#  @returns[QR@] The remainder @a[r] of floored division of a by b.
#
#  This is consistent with the remainder produced by the @l{Div} function:
#
#  @code[txt] @
#   a = b*q + r, r < b, where q = floor(a/b)
#
#  The remainder r has the same sign as the divisor b.
#
#  Behavior is undefined if the divisor b is 0.
#
#  For example:
#
#  @code[fble] @
#   Int@ two = Quot(Int|11, Int|3);
#   Int@ minus_one = Quot(Int|11, Neg(Int|3));
(Int@, Int@) { Int@; } Mod = (Int@ a, Int@ b) {
  Div(a, b).r;
};

@(QR@, Div, Quot, Mod);
