# @module[/Std/List/Show%]
#  The @l{Show@} instance for @l{List@}.

String, Format .= /Std/Char/Ascii/Stream%;
List@ .= /Std/List%;
Show@ .= /Std/Show%;
Puts .= /Std/Stream%;
Unit@ .= /Std/Unit%;

# @dev
#  @func[Tail] Shows the tail part of a list.
#   Shows list contents assuming some elements of a bigger list have already
#   been shown.
#
#   For examle, the list @l{List[1, 2, 3]} is shown as @l{", 1, 2, 3]"}.
#
#   @arg[@][T@] The type of elements on the list.
#   @arg[Show@<T@>][show] How to show an element of the list.
#   @arg[List@<T@>][list] The list to show.
#   @returns[Stream@<Char@>]
#    A string representation of the tail of a list. For example, the list
#    @l{[1, 2, 3]} is shown as @l{", 1, 2, 3]"}.
<@ T@>(Show@<T@>) { Show@<List@<T@>>; }
Tail = <@ T@>(Show@<T@> show, List@<T@> list) {
  list.?(empty: String|']');
  Unit@ _ := Puts(Format|', %s'[show(list.items.head)]);
  Tail(show, list.items.tail);
};

# @func[Show] Show a List@ value.
#  @arg[@][T@] The type of element on the list.
#  @arg[Show@<T@>][show] How to show an element of the list.
#  @arg[List@<T@>][list] The list to show.
#  @returns[Stream@<Char@>] A human readable representation of the list.
#
#  For example:
#
#  @code[fble] @
#   /Std/List/Show%.Show(/Std/Bool/Show%.Show, List[True, False, False]);
#
#  Shows as:
#
#  @code[txt] @
#   [True, False, False]
<@ T@>(Show@<T@>) { Show@<List@<T@>>; }
Show = <@ T@>(Show@<T@> show, List@<T@> list) {
  list.?(empty: String|'[]');
  Format|'[%s%s'[show(list.items.head), Tail(show, list.items.tail)];
};

@(Show);
