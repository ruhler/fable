# @module[/Std/Int/IntP/Data%]
#  The Data@ instance for IntP@.
#
#  This module is for internal use only.

Data@, Bit@, 0, 1 .= /Std/Data%;
IntP@ .= /Std/Int/IntP%;
Stream@, End, Put, Puts, Return, Map .= /Std/Stream%;
Unit@ .= /Std/Unit%;

# @func[Data] Convert an IntP@ to a data bit stream.
#  The lexicographical order of the generated bit streams matches the natural
#  order for integers.
#
#  @arg[IntP@][x] The integer to convert.
#  @returns[Stream@<Bit@>] The stream of bits describing the IntP@.
Data@<IntP@> Data = {
  # Encode our integer as unary number N followed by N bits describing the
  # actual integer value without the leading most significant bit. So:
  #
  # 1: 0  
  # 2: 10 0
  # 3: 10 1
  # 4: 110 00
  # 5: 110 01
  # 6: 110 10
  # 7: 110 11
  #
  # And so on.

  # Compute the number of bits N needed to encode x. Output that number N
  # using a unary encoding: 0, 10, 110, 1110, ...
  (IntP@) { Stream@<Bit@>; }
  NumBits = (IntP@ x) {
    x.?(
      1: Return(0),
      2p0: { Unit@ _ := Put(1); NumBits(x.2p0); },
      2p1: { Unit@ _ := Put(1); NumBits(x.2p1); });
  };

  # Output the raw bits of the number in order, not including the most
  # significant bit.
  (IntP@) { Stream@<Bit@>; }
  RawBits = (IntP@ x) {
    x.?(
      1: End<Bit@>,
      2p0: { Unit@ _ := Puts(RawBits(x.2p0)); Return(0); },
      2p1: { Unit@ _ := Puts(RawBits(x.2p1)); Return(1); });
  };

  (IntP@ x) {
    Unit@ _ := Puts(NumBits(x));
    RawBits(x);
  };
};

# @func[DataR] Convert an IntP@ to a reverse ordered data bit stream.
#  The lexicographical order of the generated bit streams is the reverse of
#  the natural order for integers.
#
#  @arg[IntP@][x] The integer to convert.
#  @returns[Stream@<Bit@>] The stream of bits describing the IntP@.
Data@<IntP@> DataR = (IntP@ x) {
  # Same encoding as forward, but flip the bits 0 to 1 and 1 to 0 so it comes
  # out in the opposite order.
  Bit@ b := Map(Data(x));
  b.?(0: 1, 1: 0);
};

@(Data, DataR).%(@/Std/Int%);
