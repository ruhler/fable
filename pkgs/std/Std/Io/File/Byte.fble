# @module[/Std/Io/File/Byte%]
#  Reading and writing bytes from files and streams.
#
#  The files can be open in either Binary or Text mode, which only effects the
#  line endings. Either way they will be read as a sequence of bytes. See also
#  @l{/Std/Io/File/Char%} for a way to read files as a sequence of characters.

Str .= /Std/Char/Ascii%;
Int@ .= /Std/Int%;
External@, Io@ .= /Std/Io%;
Mode@ .= /Std/Io/File/Mode%;
Maybe@, Just, Nothing .= /Std/Maybe%;
Monad@ .= /Std/Monad%;
Stream@ .= /Std/Stream%;
In@ .= /Std/Stream/In%;
Out@ .= /Std/Stream/Out%;
String@ .= /Std/String%;
Unit@, Unit .= /Std/Unit%;

# @type[Byte@] An integer that holds 8 bits of data.
Byte@ = Int@;

# @dev
#  @type[File@] Pretend type for FILE*.
#   Only to be accessed from FFI functions.
File@ = *(Unit@ file);

# @dev
#  Foreign functions for byte based file IO.
(Mode@) { External@<File@>; } GetStdin;
(Mode@) { External@<File@>; } GetStdout;
(Mode@) { External@<File@>; } GetStderr;
(String@, String@) { External@<Maybe@<File@>>; } Open;
(File@) { External@<Unit@>; } Flush;
(File@) { External@<Maybe@<Byte@>>; } GetByte;
(File@, Byte@) { External@<Unit@>; } PutByte;

# @dev
#  @func[Output] Output a stream of bytes to a file.
#   @arg[<@>@][M@] The monadic context type.
#   @arg[Monad@<M@>][m] The monad instance for the context.
#   @arg[Io@<M@>][io] Handle to IO interface.
#   @arg[File@][file] The file to write to.
#   @arg[Stream@<Byte@>][output] The bytes to write.
#   @returns[M@<Unit@>]
#    A computation that writes all the bytes in the stream to the given file
#    then flushes the file.
<<@>@ M@>(Monad@<M@>, Io@<M@>, File@, Stream@<Byte@>) { M@<Unit@>; }
Output = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, File@ file, Stream@<Byte@> output) {
  Unit@ _ := {
    Unit@ _, Byte@ byte, (Unit@) { M@<Unit@>; } r := output(Unit);
    Unit@ _ := m.do(io.run(PutByte(file, byte)));
    r(Unit);
  };
  io.run(Flush(file));
};

# @dev
#  @func[Out] Provide an Out@ interface for writing to a file.
#   @arg[<@>@][M@] The monadic context type.
#   @arg[Monad@<M@>][m] The monad instance for the context.
#   @arg[Io@<M@>][io] Handle to IO interface.
#   @arg[File@][file] The file to write to.
#   @returns[M@<Unit@>]
#    An output stream that outputs to the given file.
<<@>@ M@>(Monad@<M@>, Io@<M@>, File@) { Out@<Byte@, M@>; }
Out = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, File@ file) {
  Output(m, io, file);
};

# @func[Stdin] Standard input stream.
#  @arg[<@>@][M@] The monadic type for side effects.
#  @arg[Monad@<M@>][m] The monad instance.
#  @arg[Io@<M@>][io] Interface for performing io.
#  @arg[Mode@][mode] Whether to open in binary or text mode.
#  @returns[M@<In@<Byte@, M@>>] The standard input stream.
#
#  For example, to read the first byte of standard input:
#
#  @code[fble] @
#   Main@ Demo = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, List@<String@> args) {
#     In@<Byte@, M@> in := m.do(/Std/Io/File/Byte%.Stdin(m, io, Binary));
#     Maybe@<Byte@> mbyte := m.do(in);
#     mbyte.?(nothing: ...);   # empty input file.
#     Byte@ byte = mbyte.just;  # byte is the first byte of the input.
#     ...
#   };
<<@>@ M@>(Monad@<M@>, Io@<M@>, Mode@) { M@<In@<Byte@, M@>>; }
Stdin = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, Mode@ mode) {
  File@ stdin := m.do(io.run(GetStdin(mode)));
  m.return(io.run(GetByte(stdin)));
};

# @func[Stdout] Standard output stream.
#  @arg[<@>@][M@] The monadic type for side effects.
#  @arg[Monad@<M@>][m] The monad instance.
#  @arg[Io@<M@>][io] Interface for performing io.
#  @arg[Mode@][mode] Whether to open in binary or text mode.
#  @returns[M@<Out@<Byte@, M@>>] The standard output stream.
#
#  For example, to write bytes 0x61 0x62 0x63, to standard output:
#
#  Main@ Demo = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, List@<String@> args) {
#    Out@<Byte@, M@> out := m.do(/Std/Io/File/Byte%.Stdout(m, io, Binary));
#    Unit@ _ := out(Each[Hex|61, Hex|62, Hex|63]);
#    m.return(Success);
#  };
<<@>@ M@>(Monad@<M@>, Io@<M@>, Mode@) { M@<Out@<Byte@, M@>>; }
Stdout = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, Mode@ mode) {
  File@ stdout := m.do(io.run(GetStdout(mode)));
  m.return(Out(m, io, stdout));
};

# @func[Stderr] Standard error stream.
#  @arg[<@>@][M@] The monadic type for side effects.
#  @arg[Monad@<M@>][m] The monad instance.
#  @arg[Io@<M@>][io] Interface for performing io.
#  @arg[Mode@][mode] Whether to open in binary or text mode.
#  @returns[M@<Out@<Byte@, M@>>] The standard error stream.
#
#  For example, to write bytes 0x61 0x62 0x63, to standard error:
#
#  @code[fble] @
#   Main@ Demo = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, List@<String@> args) {
#     Out@<Byte@, M@> out := m.do(/Std/Io/File/Byte%.Stderr(m, io, Binary));
#     Unit@ _ := out(Each[Hex|61, Hex|62, Hex|63]);
#     m.return(Success);
#   };
<<@>@ M@>(Monad@<M@>, Io@<M@>, Mode@) { M@<Out@<Byte@, M@>>; }
Stderr = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, Mode@ mode) {
  File@ stderr := m.do(io.run(GetStderr(mode)));
  m.return(Out(m, io, stderr));
};

# @func[Read] Opens a file for reading.
#  @arg[<@>@][M@] The monadic type for side effects.
#  @arg[Monad@<M@>][m] The monad instance.
#  @arg[Io@<M@>][io] Interface for performing io.
#  @arg[String@][path] Path to the file to open.
#  @arg[Mode@][mode] Whether to open in binary or text mode.
#  @returns[M@<Maybe@<In@<Byte@, M@>>>]
#   An input stream for the file to read. Nothing if the file could not be
#   opened for reading.
#
#  The opened file will be closed automatically when you are done reading from
#  it.
#
#  For example, to read the first byte of a file 'foo.txt':
#
#  @code[fble] @
#   Main@ Demo = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, List@<String@> args) {
#     Maybe@<In@<Byte@, M@>> min := m.do(/Std/Io/File/Byte%.Read(m, io, Str|'foo.txt', Binary));
#     min.?(nothing: ...);            # unable to open file.
#     In@<Byte@, M@> in = min.just;   # file opened for read.
#     Maybe@<Byte@> mbyte := m.do(in);
#     mbyte.?(nothing: ...);          # the file is empty.
#     Byte@ byte = mbyte.just;         # byte is the first byte of the file.
#     ...
#   };
<<@>@ M@>(Monad@<M@>, Io@<M@>, String@, Mode@) { M@<Maybe@<In@<Byte@, M@>>>; }
Read = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, String@ path, Mode@ mode) {
  String@ modestr = mode.?(binary: Str|rb, text: Str|r);
  Maybe@<File@> file := m.do(io.run(Open(path, modestr)));
  file.?(nothing: m.return(Nothing<In@<Byte@, M@>>));
  m.return(Just(io.run(GetByte(file.just))));
};

# @func[Write] Opens a file for writing.
#  @arg[<@>@][M@] The monadic type for side effects.
#  @arg[Monad@<M@>][m] The monad instance.
#  @arg[Io@<M@>][io] Interface for performing io.
#  @arg[String@][path] Path to the file to open.
#  @arg[Mode@][mode] Whether to open in binary or text mode.
#  @returns[M@<Maybe@<Out@<Byte@, M@>>>]
#   An output stream for writing to the file. Nothing if the file could not be
#   opened for writing.
#
#  The opened file is closed automatically when you are done writing to it.
#
#  For example, to write bytes 0x61 0x62 0x63, to foo.txt:
#
#  @code[fble] @
#   Main@ Demo = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, List@<String@> args) {
#     Maybe@<Out@<Byte@, M@>> mout := m.do(/Std/Io/File/Byte%.Write(m, io, Str|'foo.txt', Binary));
#     mout.?(nothing: ...);             # unable to open file.
#     Out@<Byte@, M@> out := mout.just; # file open for writing.
#     Unit@ _ := out(Each[Hex|61, Hex|62, Hex|63]);
#     m.return(Success);
#   };
<<@>@ M@>(Monad@<M@>, Io@<M@>, String@, Mode@) { M@<Maybe@<Out@<Byte@, M@>>>; }
Write = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, String@ path, Mode@ mode) {
  String@ modestr = mode.?(binary: Str|wb, text: Str|w);
  Maybe@<File@> file := m.do(io.run(Open(path, modestr)));
  file.?(nothing: m.return(Nothing<Out@<Byte@, M@>>));
  m.return(Just(Out(m, io, file.just)));
};

# @func[Append] Opens a file for appending.
#  @arg[<@>@][M@] The monadic type for side effects.
#  @arg[Monad@<M@>][m] The monad instance.
#  @arg[Io@<M@>][io] Interface for performing io.
#  @arg[String@][path] Path to the file to open.
#  @arg[Mode@][mode] Whether to open in binary or text mode.
#  @returns[M@<Maybe@<Out@<Byte@, M@>>>]
#   An output stream for appending to the file. Nothing if the file could not
#   be opened for writing.
#
#  The file is closed automatically when you are done appending to it.
#
#  For example, to append bytes 0x61 0x62 0x63, to foo.txt:
#
#  @code[fble] @
#   Main@ Demo = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, List@<String@> args) {
#     Maybe@<Out@<Byte@, M@>> mout := m.do(/Std/Io/File/Byte%.Append(m, io, Str|'foo.txt', Binary));
#     mout.?(nothing: ...);             # unable to open file.
#     Out@<Byte@, M@> out := mout.just; # file open for appending.
#     Unit@ _ := out(Each[Hex|61, Hex|62, Hex|63]);
#     m.return(Success);
#   };
<<@>@ M@>(Monad@<M@>, Io@<M@>, String@, Mode@) { M@<Maybe@<Out@<Byte@, M@>>>; }
Append = <<@>@ M@>(Monad@<M@> m, Io@<M@> io, String@ path, Mode@ mode) {
  String@ modestr = mode.?(binary: Str|ab, text: Str|a);
  Maybe@<File@> file := m.do(io.run(Open(path, modestr)));
  file.?(nothing: m.return(Nothing<Out@<Byte@, M@>>));
  m.return(Just(Out(m, io, file.just)));
};

@(Byte@, Stdin, Stdout, Stderr, Read, Write, Append);
